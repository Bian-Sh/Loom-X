<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LoomX.Tests</AssemblyName>
    <RootNamespace>LoomX.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomX\LoomX.csproj" />
    <ProjectReference Include="..\LoomX.PluginHost\LoomX.PluginHost.csproj" />
    <ProjectReference Include="..\LoomX.Plugin.Storage.Sqlite\LoomX.Plugin.Storage.Sqlite.csproj" />
    <!-- 插件只作静态引用（测试需要直接 new 插件类型），负载一律走下面的镜像：
         plugin.manifest.json 与 i18n/<culture>.json 都同名，靠「每个插件各占一个目录」解决冲突。 -->
    <ProjectReference Include="..\plugins\LoomX.CredentialProtection\LoomX.CredentialProtection.csproj" />
    <ProjectReference Include="..\plugins\LoomX.ToolResultCompression\LoomX.ToolResultCompression.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 插件负载在测试输出里复刻正式运行时的布局：plugins/<id>/plugin.manifest.json 与
         plugins/<id>/i18n/<culture>.json。文件名与相对路径和运行时完全一致，不改名、不分层、
         不依赖任何覆盖顺序；PluginTextCatalog 的「程序集目录 → plugins/<id>」查找顺序直接适用。 -->
    <None Include="..\plugins\LoomX.CredentialProtection\plugin.manifest.json"
          Link="plugins\loomx.credential-protection\plugin.manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\plugins\LoomX.CredentialProtection\i18n\*.json"
          Link="plugins\loomx.credential-protection\i18n\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\plugins\LoomX.ToolResultCompression\plugin.manifest.json"
          Link="plugins\loomx.tool-result-compression\plugin.manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\plugins\LoomX.ToolResultCompression\i18n\*.json"
          Link="plugins\loomx.tool-result-compression\i18n\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 保留流程探针文件，但不纳入自动化测试，避免访问真实用户数据库。 -->
    <Compile Remove="TempDbProbeTests.cs" />
  </ItemGroup>
</Project>