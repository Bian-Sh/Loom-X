<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LoomX.Tests</AssemblyName>
    <RootNamespace>LoomX.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomX\LoomX.csproj" />
    <ProjectReference Include="..\LoomX.PluginHost\LoomX.PluginHost.csproj" />
    <ProjectReference Include="..\LoomX.Plugin.Storage.Sqlite\LoomX.Plugin.Storage.Sqlite.csproj" />
    <!-- 插件只作静态引用（测试需要直接 new 插件类型），负载一律走下面的镜像：
         plugin.manifest.json 与 i18n/<culture>.json 都同名，靠「每个插件各占一个目录」解决冲突。 -->
    <ProjectReference Include="..\plugins\LoomX.CredentialProtection\LoomX.CredentialProtection.csproj" />
    <ProjectReference Include="..\plugins\LoomX.ToolResultCompression\LoomX.ToolResultCompression.csproj" />
  </ItemGroup>
  <Import Project="..\FirstPartySourcePayload.targets" />
  <Target Name="CopyFirstPartyPlugins" AfterTargets="Build">
    <Copy SourceFiles="@(_CredentialPluginPayload)"
          DestinationFiles="@(_CredentialPluginPayload->'$(OutputPath)plugins\loomx.credential-protection\%(PackageRelativePath)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CompressionPluginPayload)"
          DestinationFiles="@(_CompressionPluginPayload->'$(OutputPath)plugins\loomx.tool-result-compression\%(PackageRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 保留流程探针文件，但不纳入自动化测试，避免访问真实用户数据库。 -->
    <Compile Remove="TempDbProbeTests.cs" />
  </ItemGroup>
</Project>