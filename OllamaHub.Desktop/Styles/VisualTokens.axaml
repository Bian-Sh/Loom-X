<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 玻璃拟态配置：调整透明度时优先修改 Alpha 通道，保持色相与层级不变。 -->
  <!-- 透明度基线：Glass 72%，GlassStrong 82%，Surface 78%，SurfaceSubtle 64%。 -->
  <!-- 磨砂方案：窗口使用 AcrylicBlur，下面的 fallback 色保证不支持 Acrylic 的环境仍有冷灰蓝材质。 -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E6D5E4E9" />
  <SolidColorBrush x:Key="GlassBrush" Color="#B8DCE7EC" />
  <SolidColorBrush x:Key="GlassStrongBrush" Color="#D0F2F7F8" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#C7F8FAFB" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#A4EDF3F5" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#80C9D9DE" />
  <SolidColorBrush x:Key="BorderBrush" Color="#8094A6AB" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#A0A5B9BD" />

  <!-- 语义色：用于状态、选中态和日志级别，不参与大面积背景。 -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172126" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6D73" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A969B" />
  <SolidColorBrush x:Key="AccentBrush" Color="#287C83" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEEEF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#2D8666" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F4EE" />
  <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B8DCC8" />
  <SolidColorBrush x:Key="WarningBrush" Color="#9A6B2B" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF1D9" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#E6C98F" />
  <SolidColorBrush x:Key="DangerBrush" Color="#A94E59" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBE8EC" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#E2B5BE" />

  <!-- 深色拓扑图使用独立令牌，避免被玻璃层降低可读性。 -->
  <SolidColorBrush x:Key="GraphBackgroundBrush" Color="#07131B" />
  <SolidColorBrush x:Key="GraphBorderBrush" Color="#1D3944" />
  <SolidColorBrush x:Key="GraphTextBrush" Color="#F1F7FA" />
  <SolidColorBrush x:Key="GraphMutedBrush" Color="#91A7B1" />
  <SolidColorBrush x:Key="GraphLiveBrush" Color="#6EE7B7" />
</ResourceDictionary>
