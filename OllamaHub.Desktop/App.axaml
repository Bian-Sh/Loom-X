<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:OllamaHub.Desktop.ViewModels" xmlns:views="using:OllamaHub.Desktop.Views" x:Class="OllamaHub.Desktop.App">
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProvidersViewModel}"><views:ProvidersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView /></DataTemplate>
  </Application.DataTemplates>
  <Application.Styles><FluentTheme /></Application.Styles>
</Application>
