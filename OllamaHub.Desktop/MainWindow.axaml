<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OllamaHub.Desktop.MainWindow" Width="1180" Height="760" MinWidth="920" MinHeight="600" Title="OllamaHub 控制中心" Background="#F7F8FA">
  <Window.Styles>
    <Style Selector="ToggleButton.nav-button">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ToggleButton.nav-button:checked"><Setter Property="Background" Value="#DCE5EC"/><Setter Property="Foreground" Value="#101820"/></Style>
  </Window.Styles>
  <Grid>
    <Grid ColumnDefinitions="208,*">
      <Border Grid.Column="0" Background="#EEF1F5" BorderBrush="#D7DCE3" BorderThickness="0,0,1,0" Padding="14,22">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="8,0,8,28">
          <Border Width="34" Height="34" BorderBrush="#176B87" BorderThickness="2" CornerRadius="8">
            <TextBlock Text="O" Foreground="#176B87" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="OllamaHub" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="控制中心" FontSize="10" Opacity="0.58"/>
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="3">
                  <ToggleButton Command="{Binding NavigateCommand}" IsChecked="{Binding IsActive, Mode=OneWay}" Classes="nav-button">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                      <TextBlock Text="{Binding Icon}" Width="18" Foreground="#176B87" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Title}"/>
                    </StackPanel>
                  </ToggleButton>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#D7DCE3" BorderThickness="0,1,0,0" Padding="8,14,8,0">
          <StackPanel Spacing="3">
            <TextBlock Text="本地服务" FontSize="11" Opacity="0.58"/>
            <TextBlock Text="服务版本" FontSize="11" Opacity="0.58"/>
            <TextBlock Text="本地服务" FontSize="11" Foreground="#23835A"/>
          </StackPanel>
        </Border>
      </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="92,*">
        <Border Grid.Row="0" Background="#F7F8FA" BorderBrush="#D7DCE3" BorderThickness="0,0,0,1" Padding="32,0">
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="{Binding PageDescription}" FontSize="12" Opacity="0.62"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="32,18" Background="#F7F8FA">
          <ContentControl Content="{Binding CurrentView}"/>
        </Border>
      </Grid>
    </Grid>
    <Border x:Name="toastBorder" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Background="#17212B" CornerRadius="6" Padding="14,10" MaxWidth="420">
      <TextBlock x:Name="toastText" Foreground="White" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
