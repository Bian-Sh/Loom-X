<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OllamaHub.Desktop.MainWindow" Width="1180" Height="760" MinWidth="920" MinHeight="600" Title="OllamaHub 控制中心" Background="Transparent" TransparencyLevelHint="AcrylicBlur,Blur,Transparent" TransparencyBackgroundFallback="{DynamicResource WindowBackgroundBrush}" SystemDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="0">
  <Window.Styles>
    <Style Selector="ToggleButton.nav-button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ToggleButton.nav-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.nav-button:checked">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.nav-button:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Path.nav-icon">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Border.glass-sidebar">
      <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.topbar">
      <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.window-chrome">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.window-control /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.window-close:pointerover">
      <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.window-close:pressed">
      <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.window-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid ColumnDefinitions="228,*">
      <Border Grid.Column="0" Classes="glass-sidebar" Padding="16,24">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="8,0,8,28" PointerPressed="WindowChrome_OnPointerPressed">
            <Border Width="38" Height="38" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12">
              <PathIcon Data="M 19,3 L 22,3 L 22,16 L 35,16 L 35,19 L 22,19 L 22,32 L 19,32 L 19,19 L 6,19 L 6,16 L 19,16 Z" Foreground="{DynamicResource AccentBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="OllamaHub" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="控制中心" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Command="{Binding NavigateCommand}" IsChecked="{Binding IsActive, Mode=OneWay}" Classes="nav-button">
                    <StackPanel Orientation="Horizontal" Spacing="11">
                      <Path Classes="nav-icon" Data="{Binding IconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,16,8,0">
            <StackPanel Spacing="4">
              <TextBlock Text="本地服务" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock Text="服务版本" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="本地服务" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="104,*">
        <Border Grid.Row="0" Classes="topbar">
          <StackPanel Margin="32,40,32,0" VerticalAlignment="Center" Spacing="5">
            <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="32,20" Background="Transparent">
          <ContentControl Content="{Binding CurrentView}" />
        </Border>
      </Grid>
      <!-- 标题栏覆盖两列，品牌区与内容区都可拖动；按钮位于同一层避免命中区被遮挡。 -->
      <Border Grid.ColumnSpan="2" Classes="window-chrome" Height="32" VerticalAlignment="Top" PointerPressed="WindowChrome_OnPointerPressed">
        <Grid ColumnDefinitions="*,42,42,42" ColumnSpacing="0" Margin="0">
          <Button Grid.Column="1" Classes="window-control" Click="MinimizeButton_OnClick" ToolTip.Tip="最小化" AutomationProperties.Name="最小化">
            <Border Width="12" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
          </Button>
          <Button Grid.Column="2" Classes="window-control" Click="MaximizeButton_OnClick" ToolTip.Tip="最大化或还原" AutomationProperties.Name="最大化或还原">
            <Path Data="M 5,5 L 19,5 L 19,19 L 5,19 Z" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.1" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="3" Classes="window-control window-close" Click="CloseButton_OnClick" ToolTip.Tip="关闭" AutomationProperties.Name="关闭">
            <Path Data="M 5,5 L 19,19 M 19,5 L 5,19" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.1" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="toastBorder" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Background="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11" MaxWidth="420">
      <TextBlock x:Name="toastText" Foreground="White" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
