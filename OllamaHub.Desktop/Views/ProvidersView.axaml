<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OllamaHub.Desktop.Views.ProvidersView">
  <UserControl.Styles>
    <Style Selector="TextBlock.section-kicker"><Setter Property="FontSize" Value="11"/><Setter Property="Opacity" Value="0.58"/></Style>
    <Style Selector="TextBlock.field-label"><Setter Property="FontSize" Value="12"/><Setter Property="Opacity" Value="0.68"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E6EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="Button.action"><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#176B87"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="36"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,18,*">
    <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
      <StackPanel Spacing="5">
        <TextBlock Text="Provider" FontSize="30" FontWeight="Bold"/>
        <TextBlock Text="管理上游连接、密钥和模型配置，修改后自动保存。" Opacity="0.68"/>
      </StackPanel>
      <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" Classes="action" Margin="8,0"/>
      <Button Grid.Column="2" Content="新增 Provider" Command="{Binding NewProviderCommand}" Classes="primary"/>
    </Grid>

    <Border Grid.Row="1" Grid.Column="0" Classes="card" Padding="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Padding="16,14" BorderBrush="#E2E6EC" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3"><TextBlock Text="Provider 目录" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="选择一个 Provider 查看详情" Classes="section-kicker"/></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Providers.Count}" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.6"/>
          </Grid>
        </Border>
        <Border Grid.Row="1" Padding="12" BorderBrush="#E2E6EC" BorderThickness="0,0,0,1">
          <TextBox Watermark="搜索 Provider"/>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="12" Margin="8,8,8,0" Background="#F5F7FA" CornerRadius="8">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="28" Height="28" Background="#D9EEF2" CornerRadius="6"><TextBlock Text="P" Foreground="#176B87" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding BusinessId}" FontSize="11" Opacity="0.58"/></StackPanel>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BaseUrl}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" Margin="36,4,0,0"/>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="36,6,0,0">
                      <TextBlock Text="{Binding ApiMode}" FontSize="11" Opacity="0.6"/>
                      <TextBlock Text="{Binding Models.Count, StringFormat='{}{0} 个模型'}" FontSize="11" Opacity="0.6"/>
                      <TextBlock Text="已配置密钥" FontSize="11" Foreground="#23835A" IsVisible="{Binding HasApiKey}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="card" Padding="18" Background="#EDF7F8" BorderBrush="#B9DEE1">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <Border Width="34" Height="34" Background="#D1EEF0" CornerRadius="17" Grid.RowSpan="2"><TextBlock Text="✓" Foreground="#176B87" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2"><TextBlock Text="连接状态" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Opacity="0.68" TextWrapping="Wrap"/></StackPanel>
            <Button Grid.Column="2" Content="测试连接" Command="{Binding TestConnectionCommand}" Classes="action"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionStatus}" Margin="12,4,0,0" Foreground="#23835A"/>
          </Grid>
        </Border>

        <Border Classes="card" Padding="18">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="基础配置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Provider 的身份和上游地址" Classes="section-kicker"/></StackPanel><CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding SelectedProvider.Enabled}" VerticalAlignment="Center"/></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="5"><TextBlock Text="显示名称" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.DisplayName}" Watermark="例如：DeepSeek"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="业务 ID" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.BusinessId}" Watermark="唯一标识"/></StackPanel>
            </Grid>
            <StackPanel Spacing="5"><TextBlock Text="Base URL" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.BaseUrl}" Watermark="https://api.example.com"/></StackPanel>
            <StackPanel Spacing="5"><TextBlock Text="协议（可用分号分隔）" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.ApiMode}" Watermark="openai"/></StackPanel>
            <TextBlock Text="修改会在停止输入 500ms 后自动保存" FontSize="11" Opacity="0.55"/>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3"><TextBlock Text="密钥与请求头" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="API Key 只写入本地数据库，不会回显" Classes="section-kicker"/></StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox Text="{Binding SelectedProvider.ApiKey}" PasswordChar="●" Watermark="输入新 API Key"/><TextBlock Grid.Column="1" Text="已配置" Foreground="#23835A" VerticalAlignment="Center" IsVisible="{Binding SelectedProvider.HasApiKey}"/></Grid>
            <CheckBox Content="清除已保存的 API Key" IsChecked="{Binding SelectedProvider.ClearApiKey}"/>
            <StackPanel Spacing="5"><TextBlock Text="Headers JSON（可选）" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.HeadersJson}" AcceptsReturn="True" TextWrapping="Wrap" Height="84" Watermark="输入 JSON 对象"/></StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="模型" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Provider 下的模型列表" Classes="section-kicker"/></StackPanel><Button Grid.Column="1" Content="新增模型" Command="{Binding NewModelCommand}" Classes="action"/></Grid>
            <ListBox ItemsSource="{Binding SelectedProvider.Models}" SelectedItem="{Binding SelectedModel}" MinHeight="90" MaxHeight="220">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="4,6"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ModelId}" FontSize="11" Opacity="0.6"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Family}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/><CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="模型编辑" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="当前选中模型的覆盖配置" Classes="section-kicker"/></StackPanel><CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding SelectedModel.Enabled}" VerticalAlignment="Center"/></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="模型 ID" Classes="field-label"/><TextBox Text="{Binding SelectedModel.ModelId}" Watermark="例如：deepseek-chat"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="显示名称" Classes="field-label"/><TextBox Text="{Binding SelectedModel.DisplayName}" Watermark="对外展示名称"/></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Family" Classes="field-label"/><TextBox Text="{Binding SelectedModel.Family}"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Context Length" Classes="field-label"/><NumericUpDown Value="{Binding SelectedModel.ContextLength}" Minimum="1"/></StackPanel><StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Max Tokens" Classes="field-label"/><NumericUpDown Value="{Binding SelectedModel.MaxTokens}" Minimum="1"/></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Config ID（可选）" Classes="field-label"/><TextBox Text="{Binding SelectedModel.ConfigId}"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="协议覆盖（可选）" Classes="field-label"/><TextBox Text="{Binding SelectedModel.ApiMode}" Watermark="留空继承 Provider"/></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Temperature" Classes="field-label"/><NumericUpDown Value="{Binding SelectedModel.Temperature}" Minimum="0"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Top P" Classes="field-label"/><NumericUpDown Value="{Binding SelectedModel.TopP}" Minimum="0" Maximum="1"/></StackPanel></Grid>
            <CheckBox Content="支持视觉" IsChecked="{Binding SelectedModel.Vision}"/>
            <StackPanel Spacing="5"><TextBlock Text="模型 API Key（留空保持不变）" Classes="field-label"/><TextBox Text="{Binding SelectedModel.ApiKey}" PasswordChar="●"/></StackPanel>
            <CheckBox Content="清除模型级 API Key" IsChecked="{Binding SelectedModel.ClearApiKey}"/>
            <StackPanel Spacing="5"><TextBlock Text="模型 Headers JSON（可选）" Classes="field-label"/><TextBox Text="{Binding SelectedModel.HeadersJson}" AcceptsReturn="True" TextWrapping="Wrap" Height="70"/></StackPanel>
            <StackPanel Spacing="5"><TextBlock Text="Extra JSON（可选）" Classes="field-label"/><TextBox Text="{Binding SelectedModel.ExtraJson}" AcceptsReturn="True" TextWrapping="Wrap" Height="70"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存模型" Command="{Binding SaveModelCommand}" Classes="primary"/><Button Content="删除模型" Command="{Binding DeleteModelCommand}" Classes="action"/></StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
