<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OllamaHub.Desktop.Views.ProvidersView">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.62"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="TextBlock.field-label"><Setter Property="Opacity" Value="0.68"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9DEE6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="Border.stat"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9DEE6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14,12"/></Style>
    <Style Selector="Button.icon-button"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="Button.small-button"><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="32"/></Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
        <StackPanel Spacing="4">
          <TextBlock Text="Provider" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="管理上游连接、请求协议、密钥与可用模型。" Classes="muted" FontSize="13"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button Content="刷新" Command="{Binding RefreshCommand}" Classes="small-button"/>
          <Button Content="新增 Provider" Command="{Binding NewProviderCommand}" Classes="small-button"/>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
        <Border Classes="stat">
          <StackPanel Spacing="3"><TextBlock Text="Provider" Classes="muted"/><TextBlock Text="{Binding Providers.Count}" FontSize="21" FontWeight="Bold"/><TextBlock Text="{Binding EnabledProviderCount, StringFormat='{}{0} 个已启用'}" Foreground="#23835A" FontSize="11"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="stat">
          <StackPanel Spacing="3"><TextBlock Text="可用模型" Classes="muted"/><TextBlock Text="{Binding TotalModelCount}" FontSize="21" FontWeight="Bold"/><TextBlock Text="Provider 下的模型总数" Classes="muted"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="stat">
          <StackPanel Spacing="3"><TextBlock Text="受保护密钥" Classes="muted"/><TextBlock Text="{Binding ProtectedKeyCount}" FontSize="21" FontWeight="Bold"/><TextBlock Text="本地数据库保存" Classes="muted"/></StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="stat">
          <StackPanel Spacing="3"><TextBlock Text="连接健康" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="{Binding HealthyProviderCount}" FontSize="21" FontWeight="Bold"/><TextBlock Text="/" FontSize="17" VerticalAlignment="Center" Opacity="0.5"/><TextBlock Text="{Binding Providers.Count}" FontSize="17" VerticalAlignment="Center" Opacity="0.7"/></StackPanel><TextBlock Text="启用且已填写地址" Foreground="#23835A" FontSize="11"/></StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="310,*" ColumnSpacing="14" VerticalAlignment="Top">
        <Border Grid.Column="0" Classes="panel" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,*" MinHeight="420">
            <Border Padding="14,12" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2"><TextBlock Text="Provider 目录" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="按当前路由顺序显示" Classes="muted"/></StackPanel>
                <Button Grid.Column="1" Content="＋" Command="{Binding NewProviderCommand}" Classes="icon-button" ToolTip.Tip="新增 Provider"/>
              </Grid>
            </Border>
            <Border Grid.Row="1" Padding="10" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
              <TextBox Watermark="搜索 Provider"/>
            </Border>
            <ListBox Grid.Row="2" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12" Margin="0,0,0,1" Background="#F5F7FA">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="30" Height="30" Background="#D9EEF2" CornerRadius="6"><TextBlock Text="P" Foreground="#176B87" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding BusinessId}" Classes="muted"/></StackPanel>
                      </StackPanel>
                      <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BaseUrl}" Classes="muted" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="39,7,0,0"/>
                      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="9" Margin="39,5,0,0">
                        <TextBlock Text="{Binding ApiMode}" Classes="muted"/>
                        <TextBlock Text="{Binding Models.Count, StringFormat='{}{0} 个模型'}" Classes="muted"/>
                        <TextBlock Text="密钥已配置" Foreground="#23835A" FontSize="10" IsVisible="{Binding HasApiKey}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="panel" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="18,16,18,0" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3"><TextBlock Text="{Binding SelectedProvider.DisplayName}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedProvider.Models.Count, StringFormat='{}{0} 个模型 · 自动保存配置'}" Classes="muted"/></StackPanel>
                  <Button Grid.Column="1" Content="删除 Provider" Command="{Binding DeleteProviderCommand}" Classes="small-button"/>
                </Grid>
                <TabControl SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
                  <TabItem Header="基础">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="14" Margin="0,16,0,18">
                        <TextBlock Text="身份与上游" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <StackPanel Spacing="5"><TextBlock Text="显示名称" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.DisplayName}" Watermark="例如：DeepSeek"/></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Provider ID" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.BusinessId}" Watermark="唯一标识"/></StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <StackPanel Spacing="5"><TextBlock Text="Provider 类型" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.ApiMode}" Watermark="openai"/></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Base URL" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.BaseUrl}" Watermark="https://api.example.com"/></StackPanel>
                        </Grid>
                        <Border Background="#F5F7FA" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6" Padding="10">
                          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Provider 状态" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="变更会在输入停止后实时自动保存" Classes="muted"/></StackPanel><CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding SelectedProvider.Enabled}" VerticalAlignment="Center"/></Grid>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                  <TabItem Header="请求">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="14" Margin="0,16,0,18">
                        <TextBlock Text="协议与鉴权" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Spacing="5"><TextBlock Text="支持的协议（可用分号分隔）" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.ApiMode}" Watermark="openai"/></StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><StackPanel Spacing="5"><TextBlock Text="API Key" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.ApiKey}" PasswordChar="●" Watermark="输入新 API Key"/></StackPanel><TextBlock Grid.Column="1" Text="已配置" Foreground="#23835A" VerticalAlignment="Bottom" Margin="0,0,0,10" IsVisible="{Binding SelectedProvider.HasApiKey}"/></Grid>
                        <CheckBox Content="清除已保存的 API Key" IsChecked="{Binding SelectedProvider.ClearApiKey}"/>
                        <StackPanel Spacing="5"><TextBlock Text="Headers JSON（可选）" Classes="field-label"/><TextBox Text="{Binding SelectedProvider.HeadersJson}" AcceptsReturn="True" TextWrapping="Wrap" Height="88" Watermark="输入 JSON 对象"/></StackPanel>
                        <Border Background="#EDF7F0" BorderBrush="#B7DFC6" BorderThickness="1" CornerRadius="6" Padding="11">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="连接状态" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="#23835A" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="测试连接" Command="{Binding TestConnectionCommand}" Classes="small-button" VerticalAlignment="Center"/></Grid>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                  <TabItem Header="模型">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="14" Margin="0,16,0,18">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Watermark="搜索模型"/><Button Grid.Column="1" Content="新增模型" Command="{Binding NewModelCommand}" Classes="small-button"/><Button Grid.Column="2" Content="同步模型" IsEnabled="False" Classes="small-button" ToolTip.Tip="当前版本暂未接入远程同步"/></Grid>
                        <Border BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                          <ListBox ItemsSource="{Binding SelectedProvider.Models}" SelectedItem="{Binding SelectedModel}" MinHeight="110">
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="11,9" ColumnSpacing="12">
                                  <StackPanel Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding ModelId}" Classes="muted" FontFamily="Consolas"/></StackPanel>
                                  <TextBlock Grid.Column="1" Text="{Binding Family}" Classes="muted" VerticalAlignment="Center"/>
                                  <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Border>
                        <Border IsVisible="{Binding HasSelectedModel}" Background="#F5F7FA" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6" Padding="12">
                          <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="模型编辑" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="字段变更将实时自动保存" Classes="muted"/></StackPanel><CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding SelectedModel.Enabled}" VerticalAlignment="Center"/></Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock Text="模型 ID" Classes="field-label"/><TextBox Text="{Binding SelectedModel.ModelId}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="显示名称" Classes="field-label"/><TextBox Text="{Binding SelectedModel.DisplayName}"/></StackPanel></Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Family" Classes="field-label"/><TextBox Text="{Binding SelectedModel.Family}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Context Length" Classes="field-label"/><NumericUpDown Value="{Binding SelectedModel.ContextLength}" Minimum="1"/></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Max Tokens" Classes="field-label"/><NumericUpDown Value="{Binding SelectedModel.MaxTokens}" Minimum="1"/></StackPanel></Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Temperature" Classes="field-label"/><NumericUpDown Value="{Binding SelectedModel.Temperature}" Minimum="0"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Top P" Classes="field-label"/><NumericUpDown Value="{Binding SelectedModel.TopP}" Minimum="0" Maximum="1"/></StackPanel></Grid>
                            <CheckBox Content="支持视觉" IsChecked="{Binding SelectedModel.Vision}"/>
                            <StackPanel Spacing="4"><TextBlock Text="模型 Headers JSON（可选）" Classes="field-label"/><TextBox Text="{Binding SelectedModel.HeadersJson}" AcceptsReturn="True" TextWrapping="Wrap" Height="68"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="修改自动保存" Foreground="#23835A" VerticalAlignment="Center"/><Button Content="删除模型" Command="{Binding DeleteModelCommand}" Classes="small-button"/></StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                </TabControl>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
