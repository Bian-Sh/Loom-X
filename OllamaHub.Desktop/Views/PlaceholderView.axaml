<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OllamaHub.Desktop.Views.PlaceholderView">
  <StackPanel Spacing="12"><TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold"/><TextBlock Text="{Binding Description}" FontSize="15" Opacity="0.68"/><Border Background="White" CornerRadius="12" Padding="22" Margin="0,18,0,0" BorderBrush="#E2E6EC" BorderThickness="1"><TextBlock Text="此页面已完成导航接入，业务功能将在后续迭代中逐步实现。" Opacity="0.62"/></Border></StackPanel>
</UserControl>