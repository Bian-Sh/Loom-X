<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:OllamaHub.Desktop.ViewModels" x:Class="OllamaHub.Desktop.Views.GatewayView">
  <UserControl.Styles>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D7DCE3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.62"/></Style>
    <Style Selector="Button.icon"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Border.member"><Setter Property="BorderBrush" Value="#E4E8EE"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="8,9"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center"/>
    <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="14">
      <Border Classes="panel" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="16,14,16,12" Spacing="3"><TextBlock Text="Endpoint" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="独立维护模型组合与故障转移顺序" Classes="muted" FontSize="11"/></StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedEndpoint}">
            <ListBox.ItemTemplate><DataTemplate>
              <Border Padding="14,12" Margin="0,0,0,1" Background="#F5F7FA">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                  <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding $parent[UserControl].DataContext.ToggleEndpointCommand}" CommandParameter="{Binding}" OnContent="" OffContent=""/>
                  <TextBlock Grid.Row="1" Text="{Binding PublicUrl}" Classes="muted" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button Grid.Row="1" Grid.Column="1" Classes="icon endpoint-copy" Content="⧉" ToolTip.Tip="复制 Base URL" AutomationProperties.Name="复制 Base URL" Click="CopyEndpointUrl_OnClick" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Combos.Count, StringFormat='{}{0} 个 Combo'}" Classes="muted" FontSize="11"/>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="panel" Padding="16" IsVisible="{Binding HasSelectedEndpoint}">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedEndpoint.DisplayName}" FontSize="20" FontWeight="SemiBold"/><Button Grid.Column="1" Classes="icon" Command="{Binding AddComboCommand}" ToolTip.Tip="新增 Combo 模型" AutomationProperties.Name="新增 Combo 模型"><PathIcon Data="M 15,4 L 17,4 L 17,15 L 28,15 L 28,17 L 17,17 L 17,28 L 15,28 L 15,17 L 4,17 L 4,15 L 15,15 Z"/></Button></Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SelectedEndpoint.Combos}">
              <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GatewayComboEditorViewModel}">
                <Border BorderBrush="#D7DCE3" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Padding="8,7" Background="#F7F9FB"><Grid ColumnDefinitions="32,*,Auto,Auto" ColumnSpacing="8">
                      <Button Classes="icon" Tag="{Binding}" Click="ToggleCombo_OnClick" ToolTip.Tip="展开或折叠 Combo"><PathIcon Data="M 9,12 L 16,19 L 23,12" Width="16" Height="16"/></Button>
                      <TextBox Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" LostFocus="ComboName_OnLostFocus"/>
                      <ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding $parent[UserControl].DataContext.ToggleComboCommand}" CommandParameter="{Binding}" OnContent="" OffContent="" ToolTip.Tip="启用或停用 Combo"/>
                      <Button Grid.Column="3" Classes="icon" Command="{Binding $parent[UserControl].DataContext.RemoveComboCommand}" CommandParameter="{Binding}" ToolTip.Tip="移除 Combo 模型" AutomationProperties.Name="移除 Combo 模型"><PathIcon Data="M 10,8 L 22,8 L 21,27 L 11,27 Z M 8,6 L 24,6 L 24,8 L 8,8 Z M 13,3 L 19,3 L 20,6 L 12,6 Z M 13,11 L 13,23 M 19,11 L 19,23"/></Button>
                    </Grid></Border>
                    <StackPanel Grid.Row="1" IsVisible="{Binding IsExpanded}">
                      <Grid Margin="8,7" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="成员模型按顺序故障转移" Classes="muted" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="icon" Tag="{Binding}" Click="OpenModelPicker_OnClick" ToolTip.Tip="向 Combo 添加模型" AutomationProperties.Name="向 Combo 添加模型"><PathIcon Data="M 15,4 L 17,4 L 17,15 L 28,15 L 28,17 L 17,17 L 17,28 L 15,28 L 15,17 L 4,17 L 4,15 L 15,15 Z"/></Button></Grid>
                      <ItemsControl ItemsSource="{Binding Routes}">
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GatewayRouteEditorViewModel}">
                          <Border Classes="member" Tag="{Binding}" DragDrop.AllowDrop="True" DragDrop.Drop="Route_OnDrop">
                            <Grid ColumnDefinitions="26,*,Auto,Auto" ColumnSpacing="8">
                              <Button Classes="icon" Tag="{Binding}" PointerPressed="RouteHandle_OnPointerPressed" ToolTip.Tip="拖动调整故障转移顺序" AutomationProperties.Name="拖动调整故障转移顺序"><PathIcon Data="M 11,9 A 2,2 0 1,0 11,13 A 2,2 0 1,0 11,9 M 21,9 A 2,2 0 1,0 21,13 A 2,2 0 1,0 21,9 M 11,19 A 2,2 0 1,0 11,23 A 2,2 0 1,0 11,19 M 21,19 A 2,2 0 1,0 21,23 A 2,2 0 1,0 21,19"/></Button>
                              <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding ModelName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProviderName}" Classes="muted" FontSize="11"/></StackPanel>
                              <ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding $parent[UserControl].DataContext.ToggleRouteCommand}" CommandParameter="{Binding}" OnContent="" OffContent="" ToolTip.Tip="启用或停用成员"/>
                              <Button Grid.Column="3" Classes="icon" Command="{Binding $parent[UserControl].DataContext.RemoveRouteCommand}" CommandParameter="{Binding}" ToolTip.Tip="从 Combo 移除模型" AutomationProperties.Name="从 Combo 移除模型"><PathIcon Data="M 10,8 L 22,8 L 21,27 L 11,27 Z M 8,6 L 24,6 L 24,8 L 8,8 Z M 13,3 L 19,3 L 20,6 L 12,6 Z M 13,11 L 13,23 M 19,11 L 19,23"/></Button>
                            </Grid>
                          </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Popup x:Name="modelPopup" Placement="Bottom" IsLightDismissEnabled="True" HorizontalOffset="0" VerticalOffset="5">
      <Border x:Name="modelPickerPanel" Width="360" MaxHeight="420" Background="#FFFFFF" BorderBrush="#D7DCE3" BorderThickness="1" CornerRadius="7" Padding="8"><Grid RowDefinitions="Auto,*" RowSpacing="8"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox x:Name="modelSearch" Watermark="搜索模型..." TextChanged="ModelSearch_OnTextChanged"/><ComboBox Grid.Column="1" Width="100" ItemsSource="{Binding SortModeOptions}" SelectedItem="{Binding SelectedSortMode}"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="modelGroupsItemsControl"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GatewayModelGroup}"><StackPanel><Button Tag="{Binding}" Click="ToggleProviderGroup_OnClick" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ProviderName}"/><TextBlock Grid.Column="1" Text="{Binding ModelCount}" Classes="muted"/></Grid></Button><ItemsControl ItemsSource="{Binding Models}" IsVisible="{Binding IsExpanded}"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="ModelOption_OnClick" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ModelName}"/><TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
    </Popup>
  </Grid>
</UserControl>
