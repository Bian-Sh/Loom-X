<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OllamaHub.Desktop.Views.OverviewView">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" MinHeight="520">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="3"><TextBlock Text="网关实时拓扑" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding GraphStatus}" Opacity="0.62"/></StackPanel>
      <Border Grid.Column="1" Background="#E9F8F2" CornerRadius="8" Padding="12,8"><StackPanel><TextBlock Text="活动请求" Opacity="0.62" FontSize="11"/><TextBlock Text="{Binding ActiveRequestCount}" FontSize="22" FontWeight="Bold" Foreground="#167A57"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#EAF7FB" CornerRadius="8" Padding="12,8"><StackPanel><TextBlock Text="5 分钟请求" Opacity="0.62" FontSize="11"/><TextBlock Text="{Binding Throughput}" FontSize="22" FontWeight="Bold" Foreground="#176B87"/></StackPanel></Border>
      <Border Grid.Column="3" Background="#F4F1E8" CornerRadius="8" Padding="12,8"><StackPanel><TextBlock Text="P95" Opacity="0.62" FontSize="11"/><TextBlock Text="{Binding P95Latency}" FontSize="22" FontWeight="Bold" Foreground="#8B6A1C"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="1" Background="#07131B" BorderBrush="#1D3944" BorderThickness="1" CornerRadius="9" MinHeight="420">
      <Grid RowDefinitions="Auto,*">
        <Grid Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,4"><StackPanel Spacing="2"><TextBlock Text="Endpoint → Model" Foreground="#F1F7FA" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="共享 Model 只显示一次，活跃关系以飞线亮斑呈现" Foreground="#91A7B1" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="LIVE" Foreground="#6EE7B7" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
        <NativeWebView Grid.Row="1" x:Name="GraphWebView" MinHeight="380"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="12">
      <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E6EC" BorderThickness="1"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="本地网关" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding GatewayStatus}" FontWeight="SemiBold"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,Auto"><TextBlock Text="监听地址" Opacity="0.6"/><TextBlock Grid.Column="1" Text="{Binding Endpoint}"/></Grid><Grid Grid.Row="2" ColumnDefinitions="*,Auto"><TextBlock Text="接口状态" Opacity="0.6"/><TextBlock Grid.Column="1" Text="{Binding Version}"/></Grid><Grid Grid.Row="3" ColumnDefinitions="*,Auto"><TextBlock Text="最后检查" Opacity="0.6"/><TextBlock Grid.Column="1" Text="{Binding LastChecked}"/></Grid><StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0"><Button Content="启动网关" Command="{Binding StartCommand}"/><Button Content="停止网关" Command="{Binding StopCommand}"/><Button Content="刷新" Command="{Binding RefreshCommand}"/></StackPanel></Grid></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E6EC" BorderThickness="1"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="最近请求" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding RecentRequests.Count, StringFormat=最近 {0} 条}" Opacity="0.6"/></Grid><ItemsControl Grid.Row="1" ItemsSource="{Binding RecentRequests}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="64,70,*,Auto" ColumnSpacing="7" Margin="0,3"><TextBlock Text="{Binding Time}" Opacity="0.58" FontSize="10"/><TextBlock Text="{Binding Endpoint}" FontSize="10"/><TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" FontSize="10"/><TextBlock Text="{Binding Latency}" Opacity="0.7" FontSize="10"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
    </Grid>
  </Grid>
</UserControl>
