<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>LoomX 插件验证场：正式迁入宿主前验证 Plugin Runtime/Pipeline 与 Credential Protection 插件组合。</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\LoomX.PluginHost\LoomX.PluginHost.csproj" />
    <!-- 插件只作为负载拷贝到 plugins 目录供运行时动态发现，不做静态引用（验证 ALC 加载路径）。 -->
    <ProjectReference Include="..\plugins\LoomX.CredentialProtection\LoomX.CredentialProtection.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="FirstPartyPlugin"
                      PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyFirstPartyPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_PluginOutputDir>@(FirstPartyPlugin->'%(RootDir)%(Directory)')</_PluginOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_PluginPayload Include="$(_PluginOutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginPayload)"
          DestinationFiles="@(_PluginPayload->'$(OutputPath)plugins\loomx.credential-protection\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
