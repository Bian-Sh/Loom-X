<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LoomX.Views.ProvidersView">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="10"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="ListBox.provider-list"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBox.provider-list ListBoxItem"><Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,1"/></Style>
    <Style Selector="ListBox.provider-list ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="Border.stat"><Setter Property="Background" Value="{DynamicResource GlassStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,14"/></Style>
    <Style Selector="Button.icon-button"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.small-button"><Setter Property="Padding" Value="11,7"/><Setter Property="MinHeight" Value="34"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
        <Border Classes="stat">
          <StackPanel Spacing="3"><TextBlock Text="Provider" Classes="muted"/><TextBlock Text="{Binding Providers.Count}" FontSize="21" FontWeight="Bold"/><TextBlock Text="{Binding EnabledProviderCount, StringFormat='{}{0} 个已启用'}" Foreground="{DynamicResource SuccessBrush}" FontSize="11"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="stat">
          <StackPanel Spacing="3"><TextBlock Text="可用模型" Classes="muted"/><TextBlock Text="{Binding TotalModelCount}" FontSize="21" FontWeight="Bold"/><TextBlock Text="远程模型已发现" Foreground="{DynamicResource SuccessBrush}" FontSize="11"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="stat">
          <StackPanel Spacing="3"><TextBlock Text="受保护密钥" Classes="muted"/><TextBlock Text="{Binding ProtectedKeyCount}" FontSize="21" FontWeight="Bold"/><TextBlock Text="DPAPI CurrentUser" Foreground="{DynamicResource SuccessBrush}" FontSize="11"/></StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="stat">
          <StackPanel Spacing="3"><TextBlock Text="连接健康" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="{Binding HealthyProviderCount}" FontSize="21" FontWeight="Bold"/><TextBlock Text="/" FontSize="17" VerticalAlignment="Center" Opacity="0.5"/><TextBlock Text="{Binding Providers.Count}" FontSize="17" VerticalAlignment="Center" Opacity="0.7"/></StackPanel><TextBlock Text="等待验证" Foreground="{DynamicResource SuccessBrush}" FontSize="11"/></StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="310,*" ColumnSpacing="14" VerticalAlignment="Stretch">
        <Border Grid.Column="0" Classes="panel" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,*">
            <Border Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2"><TextBlock Text="Provider 目录" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="按当前路由顺序显示" Classes="muted"/></StackPanel>
                <Button Grid.Column="1" Command="{Binding NewProviderCommand}" Classes="icon-button" AutomationProperties.Name="新增 Provider"><PathIcon Data="M 15,4 L 17,4 L 17,15 L 28,15 L 28,17 L 17,17 L 17,28 L 15,28 L 15,17 L 4,17 L 4,15 L 15,15 Z" Width="16" Height="16"/></Button>
              </Grid>
            </Border>
            <Border Grid.Row="1" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <TextBox Watermark="搜索 Provider"/>
            </Border>
            <ListBox Grid.Row="2" Classes="provider-list" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="14,12" Background="Transparent" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="30" Height="30" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"><TextBlock Text="P" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding Enabled}"/></StackPanel></StackPanel>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" OnContent="" OffContent="" ToolTip.Tip="启用 Provider" AutomationProperties.Name="启用 Provider" VerticalAlignment="Center"/>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BaseUrl}" Classes="muted" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="39,7,0,0"/>
                      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="9" Margin="39,5,0,0">
                        <TextBlock Text="{Binding ApiMode}" Classes="muted"/>
                        <TextBlock Text="{Binding Models.Count, StringFormat='{}{0} 个模型'}" Classes="muted"/>
                        <TextBlock Text="密钥已配置" Foreground="{DynamicResource SuccessBrush}" FontSize="10" IsVisible="{Binding HasApiKey}"/>
                      </StackPanel>
                      <Button Grid.Row="3" Grid.Column="1" Classes="icon-button" Click="DeleteProviderButton_OnClick" ToolTip.Tip="删除 Provider" AutomationProperties.Name="删除 Provider" HorizontalAlignment="Right" VerticalAlignment="Center"><PathIcon Data="M 10,8 L 22,8 L 21,27 L 11,27 Z M 8,6 L 24,6 L 24,8 L 8,8 Z M 13,3 L 19,3 L 20,6 L 12,6 Z M 13,11 L 13,23 M 19,11 L 19,23" Width="14" Height="14"/></Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="panel" Padding="0">
          <Grid>
            <Border Padding="18,16,18,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" IsVisible="{Binding HasSelectedProvider}">
              <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*">
                  <StackPanel Spacing="3" IsVisible="{Binding HasSelectedProvider}"><TextBlock Text="{Binding SelectedProvider.DisplayName}" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding SelectedProvider.Models.Count}" Classes="muted"/><TextBlock Text="个模型 ·" Classes="muted"/><TextBlock Text="{Binding SelectedProvider.ApiMode}" Classes="muted"/><TextBlock Text="兼容 ·" Classes="muted"/><TextBlock Text="{Binding SelectedProvider.SelectedEndpointFormat.DisplayName}" Classes="muted" IsVisible="{Binding SelectedProvider.IsEndpointFormatVisible}"/><TextBlock Text="密钥已保护" Classes="muted" IsVisible="{Binding SelectedProvider.HasApiKey}"/></StackPanel></StackPanel>
                </Grid>
                <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
                  <TabItem Header="基础">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="14" Margin="0,16,0,18">
                        <TextBlock Text="身份与上游" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <StackPanel Spacing="5"><TextBlock Text="显示名称" Classes="muted"/><TextBox Text="{Binding SelectedProvider.DisplayName}" Watermark="例如：DeepSeek"/></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Provider ID" Classes="muted"/><TextBox Text="{Binding SelectedProvider.BusinessId}" Watermark="唯一标识"/></StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <StackPanel Spacing="5"><TextBlock Text="Provider 类型" Classes="muted"/><ComboBox ItemsSource="{Binding ProviderTypeOptions}" SelectedItem="{Binding SelectedProvider.ApiMode, Mode=TwoWay}"/></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Base URL" Classes="muted" VerticalAlignment="Center"/><Border Width="16" Height="16" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Cursor="Help" ToolTip.Tip="加不加 v1 是个问题，请遵循供应商手册" AutomationProperties.Name="加不加 v1 是个问题，请遵循供应商手册"><TextBlock Text="?" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel><TextBox Text="{Binding SelectedProvider.BaseUrl}" Watermark="https://api.example.com"/></StackPanel>
                        </Grid>
                        <StackPanel Spacing="5" IsVisible="{Binding SelectedProvider.IsEndpointFormatVisible}"><TextBlock Text="请求格式" Classes="muted"/><ComboBox ItemsSource="{Binding SelectedProvider.EndpointFormatOptions}" SelectedItem="{Binding SelectedProvider.SelectedEndpointFormat, Mode=TwoWay}"/></StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                  <TabItem Header="请求">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="14" Margin="0,16,0,18">
                        <TextBlock Text="鉴权与网络" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Spacing="5"><TextBlock Text="API Key" Classes="muted"/><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding SelectedProvider.ApiKey}" PasswordChar="{Binding SelectedProvider.ApiKeyPasswordChar}" Watermark="{Binding SelectedProvider.ApiKeyWatermark}" Padding="12,9,46,9"/><Button Grid.Column="1" Width="38" Height="34" Margin="-42,0,4,0" Background="Transparent" BorderThickness="0" Click="ToggleApiKeyVisibilityButton_OnClick" ToolTip.Tip="{Binding SelectedProvider.ApiKeyVisibilityToolTip}" AutomationProperties.Name="{Binding SelectedProvider.ApiKeyVisibilityToolTip}"><Panel Width="18" Height="18"><Path Classes="icon-glyph" Data="M 1,12 C 4,5 20,5 23,12 C 20,19 4,19 1,12 Z M 12,8 A 4,4 0 1,0 12,16 A 4,4 0 1,0 12,8 Z" IsVisible="{Binding SelectedProvider.IsApiKeyVisible}"/><Path Classes="icon-glyph" Data="M 1,12 C 4,5 20,5 23,12 C 20,19 4,19 1,12 Z M 12,8 A 4,4 0 1,0 12,16 A 4,4 0 1,0 12,8 Z M 3,3 L 21,21" IsVisible="{Binding SelectedProvider.IsApiKeyHidden}"/></Panel></Button></Grid></StackPanel>
                        <CheckBox Content="使用代理" IsChecked="{Binding SelectedProvider.UseProxy}"/>
                        <StackPanel Spacing="7">
                          <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="自定义请求头" FontSize="13" FontWeight="SemiBold"/><Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8" Padding="6,2"><TextBlock Text="{Binding SelectedProvider.Headers.Count}" Classes="muted"/></Border></StackPanel><Button Grid.Column="1" Content="添加" Classes="small-button" Click="AddHeaderButton_OnClick"/></Grid>
                          <ItemsControl ItemsSource="{Binding SelectedProvider.Headers}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,7" ClipToBounds="True">
                                  <Grid ColumnDefinitions="*,2*,Auto">
                                    <TextBox Text="{Binding Name}" Watermark="Header 名称" BorderThickness="0" Padding="12,9" FontFamily="Consolas"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="Header 值" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12,9" FontFamily="Consolas"/>
                                    <Button Grid.Column="2" Classes="icon-button" Width="34" Height="34" Margin="4" Click="RemoveHeaderButton_OnClick" ToolTip.Tip="删除请求头" AutomationProperties.Name="删除请求头"><Path Classes="icon-glyph" Data="M 7,7 L 25,25 M 25,7 L 7,25" Width="14" Height="14"/></Button>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border IsVisible="{Binding SelectedProvider.HasIncompleteHeaders}" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="{Binding SelectedProvider.IncompleteHeaderCount, StringFormat='有 {0} 个请求头未完成，补全名称和值后才会保存。'}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                          </Border>
                          <TextBlock Text="尚未添加自定义请求头" Classes="muted" IsVisible="{Binding SelectedProvider.HasNoHeaders}"/>
                        </StackPanel>
                          <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="连接状态" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="测试连接" Command="{Binding TestConnectionCommand}" Classes="small-button" VerticalAlignment="Center"/></Grid>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                  <TabItem Header="模型">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="12" Margin="0,16,0,18">
                        <StackPanel Spacing="4"><TextBlock Text="模型列表 URL（可选）" FontWeight="SemiBold"/><TextBox Text="{Binding SelectedProvider.ModelListUrl}" Watermark="例如：https://api.example.com/v1/models"/><TextBlock Text="留空时根据 Base URL 自动推导；填写后仅用此地址刷新模型，不影响聊天请求。" Classes="muted" TextWrapping="Wrap"/></StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Watermark="搜索模型"/><Button Grid.Column="1" Command="{Binding NewModelCommand}" Classes="small-button"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="M 15,4 L 17,4 L 17,15 L 28,15 L 28,17 L 17,17 L 17,28 L 15,28 L 15,17 L 4,17 L 4,15 L 15,15 Z" Width="14" Height="14"/><TextBlock Text="添加模型" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="2" Command="{Binding SyncModelsCommand}" Classes="small-button" AutomationProperties.Name="同步模型"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon-glyph" Data="M 26,12 A 10,10 0 1,0 23,20 M 26,12 L 20,12 M 26,12 L 26,6" Width="12" Height="12" RenderTransformOrigin="50%,50%"><Path.RenderTransform><RotateTransform Angle="{Binding SyncIconAngle}"/></Path.RenderTransform></Path><TextBlock Text="同步模型" VerticalAlignment="Center"/></StackPanel></Button></Grid>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                          <Grid RowDefinitions="Auto,*">
                            <Border Background="{DynamicResource SurfaceSubtleBrush}" Padding="10,8"><Grid ColumnDefinitions="1.5*,*,80,100,56" ColumnSpacing="8">
                              <TextBlock Text="模型" Classes="muted"/><TextBlock Grid.Column="1" Text="能力" Classes="muted"/><TextBlock Grid.Column="2" Text="上下文" Classes="muted"/><TextBlock Grid.Column="3" Text="远程状态" Classes="muted"/><TextBlock Grid.Column="4" Text="启用" Classes="muted"/>
                            </Grid></Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding SelectedProvider.Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" MinHeight="110">
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid ColumnDefinitions="1.5*,*,80,100,56" Margin="10,9" ColumnSpacing="8">
                                    <StackPanel Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding ModelId}" Classes="muted" FontFamily="Consolas"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="4" Padding="4,2"><TextBlock Text="{Binding Family}" FontSize="9"/></Border><Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="4" Padding="4,2" IsVisible="{Binding Vision}"><TextBlock Text="视觉" FontSize="9"/></Border></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ContextLength}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="已发现" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="4" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </Grid>
                        </Border>
                        <Border IsVisible="{Binding HasSelectedModel}" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                          <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="模型配置" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Command="{Binding DeleteModelCommand}" Classes="icon-button" AutomationProperties.Name="删除模型"><Path Classes="icon-glyph" Data="M 10,8 L 22,8 L 21,27 L 11,27 Z M 8,6 L 24,6 L 24,8 L 8,8 Z M 13,3 L 19,3 L 20,6 L 12,6 Z M 13,11 L 13,23 M 19,11 L 19,23" Width="15" Height="15"/></Button></Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock Text="模型 ID" Classes="muted"/><TextBox Text="{Binding SelectedModel.ModelId}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="显示名称" Classes="muted"/><TextBox Text="{Binding SelectedModel.DisplayName}"/></StackPanel></Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Family" Classes="muted"/><TextBox Text="{Binding SelectedModel.Family}"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="上下文" Classes="muted"/><NumericUpDown Value="{Binding SelectedModel.ContextLength}" Minimum="1"/></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Max Tokens" Classes="muted"/><NumericUpDown Value="{Binding SelectedModel.MaxTokens}" Minimum="1"/></StackPanel></Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12"><CheckBox Content="启用" IsChecked="{Binding SelectedModel.Enabled}"/><CheckBox Content="支持视觉" IsChecked="{Binding SelectedModel.Vision}"/></StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                </TabControl>
              </Grid>
            </Border>
            <StackPanel IsVisible="{Binding HasNoSelectedProvider}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="24">
              <TextBlock Text="暂无 Provider" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="请先从左侧目录添加 Provider。" Classes="muted" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
  </Grid>
</UserControl>
