<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:LoomX.Localization"
             x:Class="LoomX.Views.AssistantHistoryPanel"
             Width="320">

  <UserControl.Styles>
    <Style Selector="Button.history-icon">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <!-- 操作按钮（铅笔 / 删除）：默认不显示，划入该行才显示 -->
    <Style Selector="Grid.session-row Button.row-action"><Setter Property="Opacity" Value="0"/></Style>
    <Style Selector="Grid.session-row:pointerover Button.row-action"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Button.row-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    </Style>
    <Style Selector="Button.session-row-button">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.session-row-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
  </UserControl.Styles>

  <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="2">
      <ItemsControl ItemsSource="{Binding Sessions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Classes="session-row" Height="46" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">

              <!-- 展示态：点主体载入会话 -->
              <Button Grid.Column="0" Classes="session-row-button" Tag="{Binding}"
                      Click="LoadItem_OnClick" IsVisible="{Binding IsNotEditing}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      VerticalContentAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,2,0">
                  <TextBlock Text="{Binding Title}" FontSize="13"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                  <TextBlock Text="{Binding DisplayUpdatedAt}" Classes="muted" FontSize="11" HorizontalAlignment="Left"/>
                </StackPanel>
              </Button>

              <!-- 编辑态：文本框替换标题，回车提交 / Esc 取消 / 失焦提交 -->
              <TextBox Grid.Column="0" Text="{Binding EditText}" IsVisible="{Binding IsEditing}"
                      x:Name="renameBox" Tag="{Binding}"
                      KeyDown="RenameBox_OnKeyDown" LostFocus="RenameBox_OnLostFocus"
                      VerticalAlignment="Center" FontSize="13"
                      MinHeight="28" Padding="8,2" CornerRadius="8"
                      Background="{DynamicResource SurfaceBrush}"/>

              <!-- 改名铅笔：与删除同样的 hover 显隐交互 -->
              <Button Grid.Column="1" Classes="history-icon row-action" Tag="{Binding}"
                      Click="BeginRename_OnClick" IsVisible="{Binding IsNotEditing}"
                      VerticalAlignment="Center" Margin="2,0,0,0"
                      ToolTip.Tip="{l:Locale assistant.history.rename.tooltip}"
                      AutomationProperties.Name="{l:Locale assistant.history.rename.tooltip}">
                <Path Classes="icon-glyph"
                      Data="M 3,21 L 4,17 L 17.5,3.5 A 2,2 0 0 1 20.5,6.5 L 7,20 Z M 13.5,7.5 L 16.5,10.5"
                      Width="13" Height="13"/>
              </Button>

              <!-- 删除：不挤压文字，浮在行尾 -->
              <Button Grid.Column="2" Classes="history-icon row-action" Tag="{Binding}"
                      Click="DeleteItem_OnClick" IsVisible="{Binding IsNotEditing}"
                      VerticalAlignment="Center" Margin="2,0,2,0"
                      ToolTip.Tip="{l:Locale assistant.history.delete.tooltip}"
                      AutomationProperties.Name="{l:Locale assistant.history.delete.tooltip}">
                <Path Classes="icon-glyph"
                      Data="M 10,11 V 17 M 14,11 V 17 M 19,6 V 20 A 2,2 0 0 1 17,22 H 7 A 2,2 0 0 1 5,20 V 6 M 3,6 H 21 M 8,6 V 4 A 2,2 0 0 1 10,2 H 14 A 2,2 0 0 1 16,4 V 6"
                      Width="13" Height="13"/>
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 空态 -->
      <TextBlock Text="{l:Locale assistant.history.empty}" Classes="muted" FontSize="12"
                 HorizontalAlignment="Center" Margin="8,14,8,10"
                 IsVisible="{Binding HasNoSessions, FallbackValue=False, TargetNullValue=False}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
