<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:LiveMarkdown.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:l="using:LoomX.Localization"
             x:Class="LoomX.Views.AssistantView">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

    <!-- 顶部：历史会话 + 新会话 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <ComboBox Grid.Column="0"
                ItemsSource="{Binding Sessions}"
                SelectedItem="{Binding SelectedSession}"
                PlaceholderText="{l:Locale assistant.history.placeholder}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Content="{l:Locale assistant.new_session}" Command="{Binding NewSessionCommand}" Margin="8,0,0,0" />
    </Grid>

    <!-- 消息流 -->
    <ScrollViewer Grid.Row="1" x:Name="MessageScroll">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">

              <!-- 状态/工具消息 -->
              <TextBlock IsVisible="{Binding IsStatus}"
                         Text="{Binding Text}"
                         FontSize="12"
                         Opacity="0.65"
                         TextWrapping="Wrap"
                         Margin="4,0" />

              <!-- 用户消息：右对齐气泡 -->
              <Border IsVisible="{Binding IsUser}"
                      HorizontalAlignment="Right"
                      MaxWidth="560"
                      Padding="10,8"
                      CornerRadius="10"
                      Background="{DynamicResource AccentSoftBrush}"
                      BorderBrush="{DynamicResource AccentBrush}"
                      BorderThickness="1">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>

              <!-- 助手消息：Markdown 实时渲染 -->
              <Border IsVisible="{Binding IsAssistantMessage}"
                      HorizontalAlignment="Left"
                      MaxWidth="640"
                      Padding="10,8"
                      CornerRadius="10"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
                <md:MarkdownRenderer MarkdownBuilder="{Binding Markdown}" />
              </Border>

            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 输入区 -->
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Row="0" Text="{Binding StatusText}" FontSize="12" Opacity="0.65" Margin="2,0,0,4"
                 IsVisible="{Binding StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Text="{Binding InputText}"
                 Watermark="{l:Locale assistant.input.watermark}"
                 AcceptsReturn="False"
                 KeyDown="OnInputKeyDown" />
        <Button Grid.Column="1"
                Content="{l:Locale assistant.send}"
                Command="{Binding SendCommand}"
                IsVisible="{Binding !IsRunning}" />
        <Button Grid.Column="2"
                Content="{l:Locale assistant.cancel}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsRunning}" />
      </Grid>
    </Grid>

  </Grid>
</UserControl>
