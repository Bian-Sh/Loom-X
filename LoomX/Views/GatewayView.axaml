<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LoomX.ViewModels" x:Class="LoomX.Views.GatewayView">
  <UserControl.Styles>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="ListBox.endpoint-list"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBox.endpoint-list ListBoxItem"><Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,1"/></Style>
    <Style Selector="ListBox.endpoint-list ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
    <Style Selector="Button.icon"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="9"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Border.drag-handle"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="SizeAll"/></Style>
    <Style Selector="Border.drag-handle:disabled"><Setter Property="Cursor" Value="No"/><Setter Property="Opacity" Value="0.55"/></Style>
    <Style Selector="Ellipse.drag-dot"><Setter Property="Width" Value="3"/><Setter Property="Height" Value="3"/><Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="Border.member"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="10,9"/></Style>
    <Style Selector="Border.drag-placeholder"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="10,9"/><Setter Property="Opacity" Value="0.8"/></Style>
    <Style Selector="Border.route-drag-preview"><Setter Property="Background" Value="{DynamicResource GlassStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,9"/><Setter Property="Opacity" Value="0.98"/></Style>
    <Style Selector="Border.member-footbar"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="8,2"/></Style>
    <Style Selector="Button.footbar-add"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center"/>
    <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="14">
      <Border Classes="panel" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="16,14,16,12" Spacing="3"><TextBlock Text="Endpoint" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="独立维护模型组合与故障转移顺序" Classes="muted" FontSize="11"/></StackPanel>
          <ListBox Grid.Row="1" Classes="endpoint-list" ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedEndpoint}">
            <ListBox.ItemTemplate><DataTemplate>
              <Border Padding="14,12" Background="Transparent" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                  <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding $parent[UserControl].DataContext.ToggleEndpointCommand}" CommandParameter="{Binding}" OnContent="" OffContent=""/>
                  <TextBlock Grid.Row="1" Text="{Binding PublicUrl}" Classes="muted" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button Grid.Row="1" Grid.Column="1" Classes="icon endpoint-copy" Content="⧉" ToolTip.Tip="复制 Base URL" AutomationProperties.Name="复制 Base URL" Click="CopyEndpointUrl_OnClick" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Combos.Count, StringFormat='{}{0} 个 Combo'}" Classes="muted" FontSize="11"/>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="panel" Padding="16" IsVisible="{Binding HasSelectedEndpoint}">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedEndpoint.DisplayName}" FontSize="20" FontWeight="SemiBold"/><Button Grid.Column="1" Classes="icon" Command="{Binding AddComboCommand}" ToolTip.Tip="新增 Combo 模型" AutomationProperties.Name="新增 Combo 模型"><PathIcon Data="M 15,4 L 17,4 L 17,15 L 28,15 L 28,17 L 17,17 L 17,28 L 15,28 L 15,17 L 4,17 L 4,15 L 15,15 Z"/></Button></Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SelectedEndpoint.Combos}">
              <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GatewayComboEditorViewModel}">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Padding="8,7" Background="{DynamicResource SurfaceSubtleBrush}"><Grid ColumnDefinitions="32,*,Auto,Auto" ColumnSpacing="8">
                      <Button Classes="icon" Tag="{Binding}" Click="ToggleCombo_OnClick" ToolTip.Tip="展开或折叠 Combo"><Path Classes="icon-glyph" Data="M 11,7 L 19,16 L 11,25" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%"><Path.RenderTransform><RotateTransform Angle="{Binding ExpandIconAngle}"/></Path.RenderTransform></Path></Button>
                      <TextBox Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" LostFocus="ComboName_OnLostFocus"/>
                      <ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding $parent[UserControl].DataContext.ToggleComboCommand}" CommandParameter="{Binding}" OnContent="" OffContent="" ToolTip.Tip="启用或停用 Combo"/>
                      <Button Grid.Column="3" Classes="icon" Command="{Binding $parent[UserControl].DataContext.RemoveComboCommand}" CommandParameter="{Binding}" ToolTip.Tip="移除 Combo 模型" AutomationProperties.Name="移除 Combo 模型"><PathIcon Data="M 10,8 L 22,8 L 21,27 L 11,27 Z M 8,6 L 24,6 L 24,8 L 8,8 Z M 13,3 L 19,3 L 20,6 L 12,6 Z M 13,11 L 13,23 M 19,11 L 19,23" Width="14" Height="14"/></Button>
                    </Grid></Border>
                    <Grid Grid.Row="1" IsVisible="{Binding IsExpanded}" RowDefinitions="Auto,Auto">
                      <Grid>
                        <ItemsControl ItemsSource="{Binding Routes}">
                          <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:GatewayRouteEditorViewModel}">
                            <Panel>
                              <Border Classes="member drag-placeholder" IsVisible="{Binding IsPlaceholder}"><Grid Height="36"/></Border>
                              <Border Classes="member" IsVisible="{Binding IsRealRoute}" Tag="{Binding}">
                                <Grid ColumnDefinitions="26,*,Auto,Auto" ColumnSpacing="8">
                                  <Border Classes="icon drag-handle" Tag="{Binding}" IsEnabled="{Binding IsDragEnabled}" PointerPressed="RouteHandle_OnPointerPressed" ToolTip.Tip="拖动调整故障转移顺序" AutomationProperties.Name="拖动调整故障转移顺序" Background="Transparent"><Grid Width="12" Height="20" RowDefinitions="*,*,*" ColumnDefinitions="*,*"><Ellipse Classes="drag-dot" Grid.Row="0" Grid.Column="0"/><Ellipse Classes="drag-dot" Grid.Row="0" Grid.Column="1"/><Ellipse Classes="drag-dot" Grid.Row="1" Grid.Column="0"/><Ellipse Classes="drag-dot" Grid.Row="1" Grid.Column="1"/><Ellipse Classes="drag-dot" Grid.Row="2" Grid.Column="0"/><Ellipse Classes="drag-dot" Grid.Row="2" Grid.Column="1"/></Grid></Border>
                                  <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding ModelName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProviderName}" Classes="muted" FontSize="11"/></StackPanel>
                                  <ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding $parent[UserControl].DataContext.ToggleRouteCommand}" CommandParameter="{Binding}" OnContent="" OffContent="" ToolTip.Tip="启用或停用成员"/>
                                  <Button Grid.Column="3" Classes="icon" Command="{Binding $parent[UserControl].DataContext.RemoveRouteCommand}" CommandParameter="{Binding}" ToolTip.Tip="从 Combo 移除模型" AutomationProperties.Name="从 Combo 移除模型"><PathIcon Data="M 10,8 L 22,8 L 21,27 L 11,27 Z M 8,6 L 24,6 L 24,8 L 8,8 Z M 13,3 L 19,3 L 20,6 L 12,6 Z M 13,11 L 13,23 M 19,11 L 19,23" Width="14" Height="14"/></Button>
                                </Grid>
                              </Border>
                            </Panel>
                          </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="routeDragPreview" Classes="route-drag-preview" IsVisible="{Binding IsDragPreviewOwner}" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                          <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="8">
                            <Grid Width="12" Height="20" RowDefinitions="*,*,*" ColumnDefinitions="*,*"><Ellipse Classes="drag-dot" Grid.Row="0" Grid.Column="0"/><Ellipse Classes="drag-dot" Grid.Row="0" Grid.Column="1"/><Ellipse Classes="drag-dot" Grid.Row="1" Grid.Column="0"/><Ellipse Classes="drag-dot" Grid.Row="1" Grid.Column="1"/><Ellipse Classes="drag-dot" Grid.Row="2" Grid.Column="0"/><Ellipse Classes="drag-dot" Grid.Row="2" Grid.Column="1"/></Grid>
                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding $parent[UserControl].DataContext.DraggingRoute.ModelName}" FontWeight="SemiBold"/><TextBlock Text="{Binding $parent[UserControl].DataContext.DraggingRoute.ProviderName}" Classes="muted" FontSize="11"/></StackPanel>
                            <TextBlock Grid.Column="2" Text="拖动中" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </Grid>
                      <Grid Grid.Row="1">
                        <Border Classes="member-footbar">
                          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="成员模型按顺序故障转移" Classes="muted" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="icon footbar-add" Tag="{Binding}" Click="OpenModelPicker_OnClick" ToolTip.Tip="向 Combo 添加模型" AutomationProperties.Name="向 Combo 添加模型"><PathIcon Data="M 15,4 L 17,4 L 17,15 L 28,15 L 28,17 L 17,17 L 17,28 L 15,28 L 15,17 L 4,17 L 4,15 L 15,15 Z" Width="14" Height="14"/></Button></Grid>
                        </Border>
                      </Grid>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Popup x:Name="modelPopup" Placement="Bottom" IsLightDismissEnabled="True" HorizontalOffset="0" VerticalOffset="5">
      <Border x:Name="modelPickerPanel" Width="360" MaxHeight="420" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="modelSearch" Watermark="搜索模型..." TextChanged="ModelSearch_OnTextChanged"/>
            <Button Grid.Column="1" Classes="icon" Click="ModelSort_OnClick" ToolTip.Tip="{Binding ModelSortToolTip}" AutomationProperties.Name="{Binding ModelSortToolTip}">
              <Panel Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Classes="icon-glyph" Data="M 5,6 L 18,6 M 5,12 L 15,12 M 5,18 L 12,18 M 26,5 L 26,24 M 21,19 L 26,24 L 31,19" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsModelSortAscending}"/>
                <Path Classes="icon-glyph" Data="M 5,6 L 18,6 M 5,12 L 15,12 M 5,18 L 12,18 M 26,24 L 26,5 M 21,10 L 26,5 L 31,10" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsModelSortDescending}"/>
              </Panel>
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="modelGroupsItemsControl">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GatewayModelGroup}">
                  <StackPanel Spacing="2" Margin="0,0,0,6">
                    <Button Tag="{Binding}" Click="ToggleProviderGroup_OnClick" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource SurfaceSubtleBrush}" BorderThickness="0" Padding="10,9">
                      <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                        <Path Classes="icon-glyph" Data="M 11,7 L 19,16 L 11,25" Width="14" Height="14" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                          <Path.RenderTransform><RotateTransform Angle="{Binding ExpandIconAngle}"/></Path.RenderTransform>
                        </Path>
                        <TextBlock Grid.Column="1" Text="{Binding ProviderName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ModelCount}" Classes="muted" VerticalAlignment="Center"/>
                      </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Models}" IsVisible="{Binding IsExpanded}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Tag="{Binding}" Click="ModelOption_OnClick" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="22,0,0,0" Padding="12,8">
                            <!-- 勾选标记保持 Foreground="{DynamicResource SuccessBrush}" 的语义契约，描边图标实际使用 Stroke 渲染。 -->
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12"><TextBlock Text="{Binding ModelName}"/><Path Grid.Column="1" Classes="icon-glyph" Data="M 5,16 L 12,23 L 27,7" Width="15" Height="15" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding IsSelected}"/></Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>
