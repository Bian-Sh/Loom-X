<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LoomX.ViewModels"
        xmlns:l="using:LoomX.Localization"
        x:Class="LoomX.Views.AskUserDialog"
        Width="620"
        MinWidth="520"
        Height="680"
        MinHeight="460"
        MaxHeight="820"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        TransparencyBackgroundFallback="{DynamicResource WindowBackgroundBrush}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        ShowInTaskbar="False"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:AskUserSingleSelectFieldViewModel}">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
          <Run Text="{Binding Label}"/><Run Text="{Binding RequiredSuffix}" Foreground="{DynamicResource DangerBrush}"/>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="10,8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                  <RadioButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                  <TextBlock Margin="26,3,0,0" Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AskUserMultiSelectFieldViewModel}">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
          <Run Text="{Binding Label}"/><Run Text="{Binding RequiredSuffix}" Foreground="{DynamicResource DangerBrush}"/>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="10,8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                  <TextBlock Margin="26,3,0,0" Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AskUserNumberFieldViewModel}">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
          <Run Text="{Binding Label}"/><Run Text="{Binding RequiredSuffix}" Foreground="{DynamicResource DangerBrush}"/>
        </TextBlock>
        <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Increment}" HorizontalAlignment="Stretch"/>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AskUserTextFieldViewModel}">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
          <Run Text="{Binding Label}"/><Run Text="{Binding RequiredSuffix}" Foreground="{DynamicResource DangerBrush}"/>
        </TextBlock>
        <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="{Binding IsMultiline}" MaxLength="{Binding MaxLength}" MinHeight="42" MaxHeight="150" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Border Background="{DynamicResource DialogBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="32,Auto,*,Auto">
      <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" PointerPressed="TitleBar_OnPointerPressed">
        <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" Margin="48,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Border>

      <StackPanel Grid.Row="1" Margin="24,20,24,12" Spacing="8">
        <TextBlock Text="{Binding Question}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <Border IsVisible="{Binding HasImpactSummary}" Margin="0,4,0,0" Padding="12,10" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8">
          <TextBlock Text="{Binding ImpactSummary}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="2" Margin="24,0,24,12" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.Styles>
            <Style Selector="ContentPresenter">
              <Setter Property="Margin" Value="0,0,0,18"/>
            </Style>
          </ItemsControl.Styles>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="3" Padding="24,12,24,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" Text="{Binding ErrorSummary}" IsVisible="{Binding HasErrors}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <Button Content="{l:Locale assistant.cancel}" MinWidth="84" IsVisible="{Binding AllowCancel}" Click="CancelButton_OnClick"/>
            <Button Content="{l:Locale assistant.approval.approve}" MinWidth="84" Classes="accent" Click="SubmitButton_OnClick"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
