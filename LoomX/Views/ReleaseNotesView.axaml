<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:LiveMarkdown.Avalonia"
             xmlns:vm="using:LoomX.ViewModels"
             x:Class="LoomX.Views.ReleaseNotesView"
             x:DataType="vm:ReleaseNotesContentViewModel">
  <UserControl.Resources>
    <x:Double x:Key="FontSizeM">13</x:Double>
    <x:Double x:Key="FontSizeL">14</x:Double>
    <x:Double x:Key="FontSizeXl">15</x:Double>
    <x:Double x:Key="FontSize2Xl">16</x:Double>
    <x:Double x:Key="FontSize3Xl">18</x:Double>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="md|MarkdownRenderer.release-note-body md|MarkdownTextBlock">
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <ScrollViewer IsVisible="{Binding HasContent}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <md:MarkdownRenderer Classes="release-note-body"
                           Margin="0,0,8,0"
                           LinkClick="MarkdownRenderer_OnLinkClick"
                           md:MarkdownTextBlock.IsSelectionScope="True"
                           MarkdownBuilder="{Binding Markdown}" />
    </ScrollViewer>
    <TextBlock IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyText}"
               Foreground="{DynamicResource TextSecondaryBrush}"
               TextWrapping="Wrap"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
  </Grid>
</UserControl>
