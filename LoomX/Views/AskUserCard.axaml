<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LoomX.ViewModels"
        xmlns:l="using:LoomX.Localization"
        x:Class="LoomX.Views.AskUserCard"
        Width="520"
        MaxWidth="520">
  <UserControl.Styles>
    <Style Selector="Button.card-icon">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.card-icon:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.card-action">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.card-secondary">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.choice-row:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:AskUserSingleSelectFieldViewModel}">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="choice-row" Margin="0,0,0,4" Padding="8,4" MinHeight="30" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="SingleChoice_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="0" Padding="0">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </RadioButton>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Text="{Binding CustomInput, Mode=TwoWay}"
                 Watermark="{Binding CustomInputPlaceholder}"
                 MaxLength="{Binding CustomInputMaxLength}"
                 IsVisible="{Binding AllowsCustomInput}"
                 KeyDown="SelectionCustomInput_OnKeyDown"/>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AskUserMultiSelectFieldViewModel}">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="choice-row" Margin="0,0,0,4" Padding="8,4" MinHeight="30" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="0" Padding="0">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Text="{Binding CustomInput, Mode=TwoWay}"
                 Watermark="{Binding CustomInputPlaceholder}"
                 MaxLength="{Binding CustomInputMaxLength}"
                 IsVisible="{Binding AllowsCustomInput}"
                 KeyDown="SelectionCustomInput_OnKeyDown"/>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AskUserNumberFieldViewModel}">
      <StackPanel Spacing="8">
        <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay}"
                       Minimum="{Binding Minimum}"
                       Maximum="{Binding Maximum}"
                       Increment="{Binding Increment}"
                       HorizontalAlignment="Stretch"
                       KeyDown="NumberInput_OnKeyDown"/>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AskUserTextFieldViewModel}">
      <StackPanel Spacing="8">
        <TextBox x:Name="DecisionTextInput"
                 Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="{Binding IsMultiline}"
                 MaxLength="{Binding MaxLength}"
                 MinHeight="36"
                 MaxHeight="120"
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 KeyDown="TextInput_OnKeyDown"/>
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Border Background="{DynamicResource DialogBackgroundBrush}"
          BorderBrush="{DynamicResource BorderStrongBrush}"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto">
      <ScrollViewer Grid.Row="0"
                    Margin="16,14,16,0"
                    MaxHeight="440"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

          <TextBlock Text="{Binding Question}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
          <Border IsVisible="{Binding HasImpactSummary}"
                  Padding="8,6"
                  Background="{DynamicResource WarningSoftBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <TextBlock Text="{Binding ImpactSummary}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
          </Border>
          <ContentControl Content="{Binding CurrentField}" Margin="0,0,0,0"/>
          <TextBlock Text="{Binding ErrorSummary}" IsVisible="{Binding HasErrors}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <Button Grid.Row="0"
              x:Name="CancelInputButton"
              Classes="card-icon"
              Content="×"
              FontSize="18"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,8,8,0"
              ToolTip.Tip="{l:Locale assistant.decision.cancel_input}"
              AutomationProperties.Name="{l:Locale assistant.decision.cancel_input}"
              IsVisible="{Binding AllowCancel}"
              Click="CancelInputButton_OnClick"/>

      <Border Grid.Row="1" Margin="16,6,16,8">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="PreviousButton"
                    Classes="card-icon"
                    Content="‹"
                    FontSize="17"
                    IsEnabled="{Binding HasPreviousField}"
                    ToolTip.Tip="{l:Locale assistant.decision.previous}"
                    Click="PreviousButton_OnClick"/>
            <TextBlock MinWidth="36"
                       Text="{Binding StepText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
            <Button x:Name="NextButton"
                    Classes="card-icon"
                    Content="›"
                    FontSize="17"
                    IsEnabled="{Binding HasNextField}"
                    ToolTip.Tip="{l:Locale assistant.decision.next}"
                    Click="NextButton_OnClick"/>
          </StackPanel>

          <Button Grid.Column="2"
                  Margin="0,0,8,0"
                  Classes="card-secondary card-action"
                  Content="{l:Locale assistant.decision.skip}"
                  IsVisible="{Binding CanSkipCurrentField}"
                  Click="SkipButton_OnClick"/>
          <Button Grid.Column="3"
                  Classes="accent card-action"
                  Content="{Binding PrimaryActionText}"
                  Click="PrimaryButton_OnClick"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
