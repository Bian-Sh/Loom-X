<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LoomX.Views.PlaceholderView">
  <StackPanel Spacing="12"><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/><Border Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,18,0,0"><TextBlock Text="此页面已完成导航接入，业务功能将在后续迭代中逐步实现。" Foreground="{DynamicResource TextSecondaryBrush}"/></Border></StackPanel>
</UserControl>
