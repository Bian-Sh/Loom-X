<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:LoomX.Localization" x:Class="LoomX.Views.PlaceholderView">
  <StackPanel Spacing="12"><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/><Border Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,18,0,0"><TextBlock Text="{l:Locale placeholder.empty.body}" Foreground="{DynamicResource TextSecondaryBrush}"/></Border></StackPanel>
</UserControl>
