<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:LoomX.Localization"
             xmlns:controls="using:LoomX.Controls"
             x:Class="LoomX.Views.PluginsView">
  <UserControl.Styles>
    <Style Selector="Border.surface-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.metric-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,11"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid IsVisible="{Binding IsPluginListVisible}" RowDefinitions="Auto,*" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
        <Border Classes="metric-card">
          <StackPanel Spacing="3">
            <TextBlock Text="{l:Locale plugins.summary.loaded.label}" Classes="tertiary" FontSize="11"/>
            <TextBlock Text="{Binding PluginCountLabel}" FontSize="16" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="metric-card">
          <StackPanel Spacing="3">
            <TextBlock Text="{l:Locale plugins.summary.enabled.label}" Classes="tertiary" FontSize="11"/>
            <TextBlock Text="{Binding EnabledCountLabel}" FontSize="16" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="metric-card">
          <StackPanel Spacing="3">
            <TextBlock Text="{l:Locale plugins.summary.diagnostics.label}" Classes="tertiary" FontSize="11"/>
            <TextBlock Text="{Binding DiagnosticCountLabel}" FontSize="16" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
      </Grid>
      <Button Grid.Column="1" Content="{l:Locale plugins.action.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Margin="0,0,8,0">
        <Border Classes="surface-card" Padding="16" IsVisible="{Binding IsEmpty}">
          <StackPanel Spacing="5">
            <TextBlock Text="{l:Locale plugins.empty.title}" Classes="section-title"/>
            <TextBlock Text="{l:Locale plugins.empty.description}" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Classes="surface-card" Padding="16" IsVisible="{Binding HasLoadError}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <PathIcon Data="M 16,5 L 28,27 L 4,27 Z M 16,12 L 16,19 M 16,23 L 16,23" Foreground="{DynamicResource ErrorBrush}" Width="20" Height="20" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="{l:Locale plugins.error.title}" Classes="section-title"/>
              <TextBlock Text="{l:Locale plugins.error.description}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Plugins}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="surface-card" Padding="16" Margin="0,0,0,10">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="11">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="38" Height="38" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9">
                      <PathIcon Data="M 8,13 L 13,13 L 13,8 L 19,8 L 19,13 L 24,13 L 24,19 L 19,19 L 19,24 L 13,24 L 13,19 L 8,19 Z" Foreground="{DynamicResource AccentBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/>
                        <Border Classes="badge"><TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Id}" Classes="tertiary" FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                      <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="tertiary" HorizontalAlignment="Right" FontSize="10"/>
                      </StackPanel>
                      <Button Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="6"
                              IsVisible="{Binding HasDetailUi}"
                              Command="{Binding OpenDetailCommand}"
                              ToolTip.Tip="{l:Locale plugins.detail.open}">
                        <PathIcon Data="M 16,4 L 18,7 L 22,7 L 24,10 L 22,13 L 24,16 L 22,19 L 18,19 L 16,22 L 14,19 L 10,19 L 8,16 L 10,13 L 8,10 L 10,7 L 14,7 Z M 16,10 A 3,3 0 1 1 16,16 A 3,3 0 1 1 16,10" Width="16" Height="16"/>
                      </Button>
                      <ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="muted" TextWrapping="Wrap"/>

                  <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <TextBlock Text="{Binding ExtensionCountLabel}" Classes="muted" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{Binding CapabilitySummary}" Classes="tertiary" FontSize="11" TextWrapping="Wrap"/>
                  </Grid>

                  <controls:PluginUiPresenter Grid.Row="3" Contributions="{Binding CardContributions}" IsVisible="{Binding HasCardUi}"/>

                  <Border Grid.Row="4" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                      <PathIcon Data="M 16,5 L 27,10 L 27,17 C 27,24 22,29 16,31 C 10,29 5,24 5,17 L 5,10 Z M 11,17 L 15,21 L 22,13" Foreground="{DynamicResource AccentBrush}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding LifecycleNote}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="surface-card" Padding="16" IsVisible="{Binding HasDiagnostics}">
          <StackPanel Spacing="9">
            <TextBlock Text="{l:Locale plugins.diagnostics.title}" Classes="section-title"/>
            <TextBlock Text="{l:Locale plugins.diagnostics.description}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Diagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Status}" Classes="tertiary" FontSize="11" HorizontalAlignment="Right" Margin="0,0,2,4"/>
      </StackPanel>
    </ScrollViewer>
    </Grid>

    <ScrollViewer IsVisible="{Binding IsPluginDetailVisible}" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Margin="0,0,8,0">
        <Button Command="{Binding BackToPluginListCommand}" HorizontalAlignment="Left" Padding="10,6">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="M 21,7 L 12,16 L 21,25" Width="14" Height="14"/>
            <TextBlock Text="{l:Locale plugins.detail.back}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Border Classes="surface-card" Padding="18">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Width="42" Height="42" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10">
                <PathIcon Data="M 8,13 L 13,13 L 13,8 L 19,8 L 19,13 L 24,13 L 24,19 L 19,19 L 19,24 L 13,24 L 13,19 L 8,19 Z" Foreground="{DynamicResource AccentBrush}" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedPlugin.DisplayName}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedPlugin.Id}" Classes="tertiary" FontSize="11" FontFamily="Consolas"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedPlugin.StatusLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedPlugin.Version, StringFormat='v{0}'}" Classes="tertiary" HorizontalAlignment="Right" FontSize="10"/>
              </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding SelectedPlugin.Description}" Classes="muted" TextWrapping="Wrap"/>
            <controls:PluginUiPresenter Grid.Row="2" Contributions="{Binding SelectedPlugin.DetailContributions}"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
