<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:nodegraph="using:LoomX.NodeGraph" x:Class="LoomX.Views.OverviewView">
  <UserControl.Styles>
    <Style Selector="Border.surface-card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="Button.graph-tool"><Setter Property="MinWidth" Value="32"/><Setter Property="Width" Value="32"/><Setter Property="MinHeight" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="Button.graph-endpoint"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="10,3"/><Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GraphBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource GraphTextBrush}"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto" RowSpacing="16">
    <Border Grid.Row="0" Background="{DynamicResource GraphBackgroundBrush}" BorderBrush="{DynamicResource GraphBorderBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True" MinHeight="360" VerticalAlignment="Stretch">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,4,10,3" MinHeight="30">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="Endpoint" Foreground="{DynamicResource GraphMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <ItemsControl ItemsSource="{Binding Endpoints}" HorizontalAlignment="Left">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="graph-endpoint" Content="{Binding DisplayName}" ToolTip.Tip="聚焦 Endpoint" Click="FocusEndpoint_OnClick" IsEnabled="{Binding Enabled}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding GraphStatus}" Foreground="{DynamicResource GraphMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button Classes="graph-tool" Content="-" ToolTip.Tip="缩小" Click="ZoomOut_OnClick"/>
            <Button Classes="graph-tool" Content="+" ToolTip.Tip="放大" Click="ZoomIn_OnClick"/>
            <Button Classes="graph-tool" Content="[]" ToolTip.Tip="适合视图" Click="FitGraph_OnClick"/>
          </StackPanel>
        </Grid>
        <nodegraph:RuntimeGraphControl x:Name="RuntimeGraph" Grid.Row="1" Snapshot="{Binding GraphSnapshot}" MinHeight="320" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="12">
      <Border Classes="surface-card" Padding="16"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="本地网关" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding GatewayStatus}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,Auto"><TextBlock Text="监听地址" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding Endpoint}"/></Grid><Grid Grid.Row="2" ColumnDefinitions="*,Auto"><TextBlock Text="接口状态" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding Version}"/></Grid><Grid Grid.Row="3" ColumnDefinitions="*,Auto"><TextBlock Text="最后检查" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding LastChecked}"/></Grid><StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0"><Button Content="{Binding GatewayActionLabel}" Command="{Binding ToggleGatewayCommand}"/><Button Content="刷新" Command="{Binding RefreshCommand}"/></StackPanel></Grid></Border>
      <Border Grid.Column="1" Classes="surface-card" Padding="16"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="最近请求" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding RecentRequests.Count, StringFormat=最近 {0} 条}" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid><TextBlock Grid.Row="1" Text="暂无请求活动" IsVisible="{Binding RecentRequestsEmpty}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/><ItemsControl Grid.Row="1" ItemsSource="{Binding RecentRequests}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="58,*,64,Auto,Auto" ColumnSpacing="7" Margin="0,3"><TextBlock Grid.Column="0" Text="{Binding Endpoint}" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding Model}" TextTrimming="CharacterEllipsis" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding Time}" HorizontalAlignment="Left" TextAlignment="Left" FlowDirection="LeftToRight" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"/><TextBlock Grid.Column="3" Text="{Binding Latency}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="10"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
    </Grid>
  </Grid>
</UserControl>
