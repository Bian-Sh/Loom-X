<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LoomX</AssemblyName>
    <RootNamespace>LoomX</RootNamespace>
    <AssemblyTitle>Loom-x</AssemblyTitle>
    <Product>Loom-x</Product>
    <Description>Loom-x 本地 Ollama 与 OpenAI 兼容代理</Description>
    <Version>0.12.6</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- i18n: default resource language -->
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings.resx">
      <ManifestResourceName>LoomX.Resources.Strings</ManifestResourceName>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Strings.*.resx" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.0" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="LiveMarkdown.Avalonia" Version="1.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Overview\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Overview\three.core.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Overview\three.module.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Skills\**\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Skills\**\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BrowserExtension\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BrowserExtension\**\*.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
