<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LoomX</AssemblyName>
    <RootNamespace>LoomX</RootNamespace>
    <AssemblyTitle>Loom-x</AssemblyTitle>
    <Product>Loom-x</Product>
    <Description>Loom-x 本地 Ollama 与 OpenAI 兼容代理</Description>
    <Version>0.12.6</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- i18n: default resource language -->
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- 应用图标：exe 资源（桌面快捷方式/任务栏/文件属性） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia 资源：窗口/任务栏图标（MainWindow Icon）与标题区应用图标 -->
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\icon-transparent.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings.resx">
      <ManifestResourceName>LoomX.Resources.Strings</ManifestResourceName>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Strings.*.resx" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <ProjectReference Include="..\LoomX.Harness\LoomX.Harness.csproj" />
    <ProjectReference Include="..\LoomX.PluginHost\LoomX.PluginHost.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="LiveMarkdown.Avalonia" Version="1.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Skills\**\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Skills\**\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BrowserExtension\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BrowserExtension\**\*.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 第一方插件只作为负载拷贝到输出 plugins 目录供运行时动态发现，不做静态引用（验证 ALC 加载路径）。 -->
    <ProjectReference Include="..\plugins\LoomX.CredentialProtection\LoomX.CredentialProtection.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="FirstPartyPlugin"
                      PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyFirstPartyPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_PluginOutputDir>@(FirstPartyPlugin->'%(RootDir)%(Directory)')</_PluginOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_PluginPayload Include="$(_PluginOutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginPayload)"
          DestinationFiles="@(_PluginPayload->'$(OutputPath)plugins\loomx.credential-protection\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyFirstPartyPluginsToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_PluginPublishOutputDir>@(FirstPartyPlugin->'%(RootDir)%(Directory)')</_PluginPublishOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_PluginPublishPayload Include="$(_PluginPublishOutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginPublishPayload)"
          DestinationFiles="@(_PluginPublishPayload->'$(PublishDir)plugins\loomx.credential-protection\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
