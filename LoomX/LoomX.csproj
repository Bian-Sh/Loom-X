<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LoomX</AssemblyName>
    <RootNamespace>LoomX</RootNamespace>
    <AssemblyTitle>Loom-x</AssemblyTitle>
    <Product>Loom-x</Product>
    <Description>Loom-x 本地 Ollama 与 OpenAI 兼容代理</Description>
    <Version>0.12.6</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- i18n: default resource language -->
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- 应用图标：exe 资源（桌面快捷方式/任务栏/文件属性） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia 资源：窗口/任务栏图标（MainWindow Icon）与标题区应用图标 -->
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\icon-transparent.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings.resx">
      <ManifestResourceName>LoomX.Resources.Strings</ManifestResourceName>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Strings.*.resx" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <ProjectReference Include="..\LoomX.Harness\LoomX.Harness.csproj" />
    <ProjectReference Include="..\LoomX.PluginHost\LoomX.PluginHost.csproj" />
    <ProjectReference Include="..\LoomX.Plugin.Storage.Sqlite\LoomX.Plugin.Storage.Sqlite.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="LiveMarkdown.Avalonia" Version="1.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Skills\**\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Skills\**\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BrowserExtension\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BrowserExtension\**\*.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 第一方插件只作为负载拷贝到输出 plugins 目录供运行时动态发现，不做静态引用（验证 ALC 加载路径）。
         每个插件用独立的 OutputItemType：共用一个会让两个插件的负载落到同一目录互相覆盖。
         这里不需要、也没有加 ExcludeAssets="content"：插件负载已不再以 MSBuild Content 声明
         （插件工程用自定义目标拷进自己的输出目录），MSBuild 不会把它传给本工程；
         负载本来也不该出现在应用根目录，统一由下面的拷贝目标放进 plugins/<id>/。 -->
    <ProjectReference Include="..\plugins\LoomX.CredentialProtection\LoomX.CredentialProtection.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="FirstPartyCredentialPlugin"
                      PrivateAssets="all" />
    <ProjectReference Include="..\plugins\LoomX.ToolResultCompression\LoomX.ToolResultCompression.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="FirstPartyCompressionPlugin"
                      PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyFirstPartyPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_CredentialPluginOutputDir>@(FirstPartyCredentialPlugin->'%(RootDir)%(Directory)')</_CredentialPluginOutputDir>
      <_CompressionPluginOutputDir>@(FirstPartyCompressionPlugin->'%(RootDir)%(Directory)')</_CompressionPluginOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_CredentialPluginPayload Include="$(_CredentialPluginOutputDir)**\*" />
      <_CompressionPluginPayload Include="$(_CompressionPluginOutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CredentialPluginPayload)"
          DestinationFiles="@(_CredentialPluginPayload->'$(OutputPath)plugins\loomx.credential-protection\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CompressionPluginPayload)"
          DestinationFiles="@(_CompressionPluginPayload->'$(OutputPath)plugins\loomx.tool-result-compression\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyFirstPartyPluginsToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_CredentialPluginPublishOutputDir>@(FirstPartyCredentialPlugin->'%(RootDir)%(Directory)')</_CredentialPluginPublishOutputDir>
      <_CompressionPluginPublishOutputDir>@(FirstPartyCompressionPlugin->'%(RootDir)%(Directory)')</_CompressionPluginPublishOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_CredentialPluginPublishPayload Include="$(_CredentialPluginPublishOutputDir)**\*" />
      <_CompressionPluginPublishPayload Include="$(_CompressionPluginPublishOutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CredentialPluginPublishPayload)"
          DestinationFiles="@(_CredentialPluginPublishPayload->'$(PublishDir)plugins\loomx.credential-protection\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CompressionPluginPublishPayload)"
          DestinationFiles="@(_CompressionPluginPublishPayload->'$(PublishDir)plugins\loomx.tool-result-compression\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
