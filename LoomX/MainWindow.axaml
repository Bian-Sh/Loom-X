<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:LoomX.Localization" xmlns:views="using:LoomX.Views" x:Class="LoomX.MainWindow" Width="1180" Height="760" MinWidth="920" MinHeight="600" Title="Loom-X" Icon="/Assets/app.ico" Background="Transparent" TransparencyLevelHint="AcrylicBlur,Transparent" TransparencyBackgroundFallback="{DynamicResource WindowBackgroundBrush}" SystemDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="0">
  <Window.Styles>
    <Style Selector="Button.nav-button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.nav-button.active">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav-button.active:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.navigation-selection-indicator">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.navigation-selection-outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Panel.ZIndex" Value="1" />
    </Style>
    <Style Selector="Path.nav-icon">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Border.glass-sidebar">
      <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.topbar">
      <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.window-chrome">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.window-control /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.window-close:pointerover">
      <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.window-close:pressed">
      <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.window-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.update-entry">
      <Setter Property="Height" Value="32" />
      <Setter Property="Width" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.update-entry:pointerover">
      <Setter Property="Width" Value="252" />
    </Style>
    <Style Selector="Button.update-entry:focus">
      <Setter Property="Width" Value="252" />
    </Style>
    <Style Selector="Button.update-entry /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.update-entry-text">
      <Setter Property="Width" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.update-entry:pointerover Border.update-entry-text">
      <Setter Property="Width" Value="220" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.update-entry:focus Border.update-entry-text">
      <Setter Property="Width" Value="220" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Window.Styles>
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid ColumnDefinitions="228,*">
      <Border Grid.Column="0" Classes="glass-sidebar" Padding="16,24">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="8,0,8,28" PointerPressed="WindowChrome_OnPointerPressed">
            <Image Source="/Assets/icon-transparent.png" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="Loom-X" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
              <Border x:Name="navigationSelectionIndicator" Classes="navigation-selection-indicator" IsVisible="{Binding HasActiveNavigationItem}" Margin="0,2,0,0">
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
              <ItemsControl ItemsSource="{Binding NavigationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding NavigateCommand}" Classes="nav-button" Classes.active="{Binding IsActive}">
                      <StackPanel Orientation="Horizontal" Spacing="11">
                        <Path Classes="nav-icon" Data="{Binding IconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border x:Name="navigationSelectionOutline" Classes="navigation-selection-outline" IsVisible="{Binding HasActiveNavigationItem}" Margin="0,2,0,0">
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
            </Grid>
          </ScrollViewer>
          <Border x:Name="sidebarRuntimeStatus" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,16,8,0">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding GatewayStatusText}" AutomationProperties.Name="{Binding GatewayStatusText}">
              <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
              <Panel Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsGatewayRunning}" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" IsVisible="{Binding IsGatewayTransitioning}" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsGatewayFailed}" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding IsGatewayStopped}" />
              </Panel>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="104,*">
        <Border Grid.Row="0" Classes="topbar">
          <StackPanel Margin="32,40,32,0" VerticalAlignment="Center" Spacing="5">
            <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="32,20" Background="Transparent" ClipToBounds="False">
          <ContentControl Content="{Binding CurrentView}" ClipToBounds="False" />
        </Border>
      </Grid>
      <!-- 标题栏覆盖两列，品牌区与内容区都可拖动；按钮位于同一层避免命中区被遮挡。 -->
      <Border Grid.ColumnSpan="2" Classes="window-chrome" Height="32" VerticalAlignment="Top" PointerPressed="WindowChrome_OnPointerPressed">
        <Grid ColumnDefinitions="*,Auto,42,42,42" ColumnSpacing="0" Margin="0">
          <Button x:Name="updateEntryButton" Grid.Column="1" Classes="update-entry" Height="32" MinWidth="32"
                  DataContext="{Binding $parent[Window].UpdatePresentation}"
                  IsVisible="{Binding Update.IsUpdateEntryVisible}"
                  Command="{Binding Update.ToggleDialogCommand}"
                  ToolTip.Tip="{Binding Update.UpdateEntryText}"
                  AutomationProperties.Name="{Binding Update.UpdateEntryText}">
            <Grid ClipToBounds="True">
              <Border Background="{DynamicResource SurfaceMutedBrush}" IsVisible="{Binding Update.IsPreparing}" CornerRadius="8" IsHitTestVisible="False" />
              <Border Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding Update.IsReady}" CornerRadius="8" IsHitTestVisible="False" />
              <Border Background="{DynamicResource DangerSoftBrush}" IsVisible="{Binding Update.IsError}" CornerRadius="8" IsHitTestVisible="False" />
              <Grid ColumnDefinitions="32,Auto">
                <PathIcon Data="M 12,2 L 12,14 M 7,9 L 12,14 L 17,9 M 4,16 L 20,16 L 20,20 L 4,20 Z"
                          Foreground="{DynamicResource TextPrimaryBrush}" Width="16" Height="16"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="update-entry-text" ClipToBounds="True">
                  <TextBlock Text="{Binding Update.UpdateEntryText}" Margin="0,0,12,0"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </Border>
              </Grid>
            </Grid>
          </Button>
          <Button Grid.Column="2" Classes="window-control" Click="MinimizeButton_OnClick" ToolTip.Tip="{l:Locale window.minimize}" AutomationProperties.Name="{l:Locale window.minimize}">
            <Border Width="12" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
          </Button>
          <Button Grid.Column="3" Classes="window-control" Click="MaximizeButton_OnClick" ToolTip.Tip="{l:Locale window.maximize}" AutomationProperties.Name="{l:Locale window.maximize}">
            <Path Data="M 5,5 L 19,5 L 19,19 L 5,19 Z" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="0.8" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="4" Classes="window-control window-close" Click="CloseButton_OnClick" ToolTip.Tip="{l:Locale window.close}" AutomationProperties.Name="{l:Locale window.close}">
            <Path Data="M 5,5 L 19,19 M 19,5 L 5,19" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="0.8" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="toastBorder" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Background="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11" MaxWidth="420">
      <TextBlock x:Name="toastText" Foreground="White" TextWrapping="Wrap" />
    </Border>
    <Border x:Name="updateDialogOverlay" DataContext="{Binding $parent[Window].UpdatePresentation}"
            IsVisible="{Binding Update.IsDialogVisible}" Background="{DynamicResource SurfaceMutedBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="48,56">
      <Border MaxWidth="760" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,1,*,1,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="22,18">
            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
              <PathIcon Data="M 12,2 L 12,14 M 7,9 L 12,14 L 17,9 M 4,16 L 20,16 L 20,20 L 4,20 Z"
                        Foreground="{DynamicResource AccentBrush}" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Update.LatestVersion}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Update.ReleaseNotesContent.PublishedAtText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Update.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="updateDialogCloseButton" Grid.Column="2" Width="32" Height="32" MinHeight="32"
                    Padding="0" Background="Transparent" BorderBrush="Transparent"
                    Command="{Binding Update.DismissDialogCommand}" ToolTip.Tip="{l:Locale update.dialog.close}"
                    AutomationProperties.Name="{l:Locale update.dialog.close}">
              <Path Data="M 5,5 L 19,19 M 19,5 L 5,19" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}"
                    StrokeThickness="1" Stretch="Uniform" Width="12" Height="12" />
            </Button>
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
          <views:ReleaseNotesView DataContext="{Binding Update.ReleaseNotesContent}" Grid.Row="2" Margin="22,18" />
          <Border Grid.Row="3" Background="{DynamicResource BorderBrush}" />
          <Grid Grid.Row="4" Margin="22,16">
            <Grid IsVisible="{Binding Update.IsDownloading}" RowDefinitions="Auto,Auto" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Update.ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Update.SpeedText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Update.DownloadPercent}" FontWeight="SemiBold" />
                  <TextBlock Text="%" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <ProgressBar Value="{Binding Update.DownloadPercent}" Minimum="0" Maximum="100" Height="7" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{l:Locale update.dialog.later}" Command="{Binding Update.DismissDialogCommand}" />
              </Grid>
            </Grid>
            <Grid IsVisible="{Binding Update.IsVerifying}" ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Update.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ProgressBar IsIndeterminate="True" Height="7" />
              </StackPanel>
              <Button Grid.Column="1" Content="{l:Locale update.dialog.later}" Command="{Binding Update.DismissDialogCommand}" />
            </Grid>
            <Grid IsVisible="{Binding Update.CanInstall}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <Button Grid.Column="1" Content="{l:Locale update.dialog.later}" Command="{Binding Update.DismissDialogCommand}" />
              <Button x:Name="updateInstallButton" Grid.Column="2" Classes="primary" Content="{l:Locale update.dialog.install}"
                      Command="{Binding Update.InstallAndRestartCommand}" />
            </Grid>
            <Grid IsVisible="{Binding Update.CanRetry}" RowDefinitions="Auto,Auto" RowSpacing="12">
              <TextBlock Text="{Binding Update.ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Button Grid.Column="1" Content="{l:Locale update.dialog.later}" Command="{Binding Update.DismissDialogCommand}" />
                <Button x:Name="updateRetryButton" Grid.Column="2" Classes="primary" Content="{l:Locale update.dialog.retry}"
                        Command="{Binding Update.RetryCommand}" />
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
