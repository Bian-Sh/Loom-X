<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:LoomX.Localization" xmlns:views="using:LoomX.Views" xmlns:controls="using:LoomX.Controls" x:Class="LoomX.MainWindow" Width="1180" Height="760" MinWidth="920" MinHeight="600" Title="Loom-X" Icon="/Assets/app.ico" Background="Transparent" TransparencyLevelHint="AcrylicBlur,Transparent" TransparencyBackgroundFallback="{DynamicResource WindowBackgroundBrush}" SystemDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="0">
  <Window.Styles>
    <Style Selector="Button.nav-button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.nav-button.active">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav-button.active:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.navigation-selection-indicator">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.navigation-selection-outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Panel.ZIndex" Value="1" />
    </Style>
    <Style Selector="Path.nav-icon">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Border.glass-sidebar">
      <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.topbar">
      <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.window-chrome">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.window-control /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.window-close:pointerover">
      <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.window-close:pressed">
      <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.window-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.toast-layer">
      <Setter Property="Panel.ZIndex" Value="2" />
    </Style>
    <Style Selector="Button.update-entry">
      <Setter Property="Height" Value="32" />
      <Setter Property="Width" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.update-entry:pointerover">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Button.update-entry:focus">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="Button.update-entry /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.update-entry-text">
      <Setter Property="MaxWidth" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="MaxWidth" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.update-entry:pointerover Border.update-entry-text">
      <Setter Property="MaxWidth" Value="200" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.update-entry:focus Border.update-entry-text">
      <Setter Property="MaxWidth" Value="200" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Path.update-entry-arrow">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-3" />
          </KeyFrame>
          <KeyFrame Cue="35%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="70%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="3" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid ColumnDefinitions="228,*">
      <Border Grid.Column="0" Classes="glass-sidebar" Padding="16,24">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="8,0,8,28" PointerPressed="WindowChrome_OnPointerPressed">
            <Image Source="/Assets/icon-transparent.png" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="Loom-X" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
              <Border x:Name="navigationSelectionIndicator" Classes="navigation-selection-indicator" IsVisible="{Binding HasActiveNavigationItem}" Margin="0,2,0,0">
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
              <ItemsControl ItemsSource="{Binding NavigationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding NavigateCommand}" Classes="nav-button" Classes.active="{Binding IsActive}">
                      <StackPanel Orientation="Horizontal" Spacing="11">
                        <Path Classes="nav-icon" Data="{Binding IconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border x:Name="navigationSelectionOutline" Classes="navigation-selection-outline" IsVisible="{Binding HasActiveNavigationItem}" Margin="0,2,0,0">
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
            </Grid>
          </ScrollViewer>
          <Border x:Name="sidebarRuntimeStatus" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,16,8,0">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding GatewayStatusText}" AutomationProperties.Name="{Binding GatewayStatusText}">
              <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
              <Panel Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsGatewayRunning}" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" IsVisible="{Binding IsGatewayTransitioning}" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsGatewayFailed}" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding IsGatewayStopped}" />
              </Panel>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="104,*">
        <Border Grid.Row="0" Classes="topbar">
          <StackPanel Margin="32,40,32,0" VerticalAlignment="Center" Spacing="5">
            <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="32,20" Background="Transparent" ClipToBounds="False">
          <ContentControl Content="{Binding CurrentView}" ClipToBounds="False" />
        </Border>
      </Grid>
      <!-- 标题栏覆盖两列，品牌区与内容区都可拖动；按钮位于同一层避免命中区被遮挡。 -->
      <Border Grid.ColumnSpan="2" Classes="window-chrome" Height="32" VerticalAlignment="Top" PointerPressed="WindowChrome_OnPointerPressed">
        <Grid ColumnDefinitions="*,Auto,42,42,42" ColumnSpacing="0" Margin="0">
          <Button x:Name="updateEntryButton" Grid.Column="1" Classes="update-entry" Height="32" MinWidth="32"
                  DataContext="{Binding $parent[Window].UpdatePresentation}"
                  IsVisible="{Binding Update.IsUpdateEntryVisible}"
                  Command="{Binding Update.ActivateUpdateEntryCommand}"
                  PointerEntered="UpdateEntryButton_OnPointerEntered"
                  PointerExited="UpdateEntryButton_OnPointerExited"
                  ToolTip.Tip="{Binding Update.UpdateEntryHint}"
                  AutomationProperties.Name="{Binding Update.UpdateEntryHint}">
            <Grid ClipToBounds="True">
              <Border Background="{DynamicResource UpdateEntryActiveBrush}" IsVisible="{Binding Update.IsPreparing}" CornerRadius="8" IsHitTestVisible="False" />
              <Border Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding Update.IsReady}" CornerRadius="8" IsHitTestVisible="False" />
              <Border Background="{DynamicResource DangerSoftBrush}" IsVisible="{Binding Update.IsError}" CornerRadius="8" IsHitTestVisible="False" />
              <Grid ColumnDefinitions="32,Auto">
                <!-- 下载中：箭头从上往下循环流动渐隐，底部横线固定不动 -->
                <Grid Width="16" Height="16" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding Update.IsPreparing}">
                  <Path Data="M 2.5,12.5 L 13.5,12.5 L 13.5,15 L 2.5,15 Z" Fill="{DynamicResource TextPrimaryBrush}" />
                  <Path Classes="update-entry-arrow" Data="M 8,1.5 L 8,8.5 M 4.5,5 L 8,8.5 L 11.5,5">
                    <Path.RenderTransform>
                      <TranslateTransform Y="-3" />
                    </Path.RenderTransform>
                  </Path>
                </Grid>
                <!-- 下载完成：静止的下载完成图标（Material Design download） -->
                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                          Foreground="{DynamicResource TextPrimaryBrush}" Width="16" Height="16"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsVisible="{Binding Update.IsReady}" />
                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                          Foreground="{DynamicResource TextPrimaryBrush}" Width="16" Height="16"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsVisible="{Binding Update.IsError}" />
                <Border Grid.Column="1" Classes="update-entry-text" ClipToBounds="True">
                  <TextBlock Text="{Binding Update.UpdateEntryHint}" MinWidth="28" Margin="0,0,12,0"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </Border>
              </Grid>
            </Grid>
          </Button>
          <Popup x:Name="updateReleasePreviewPopup"
                 DataContext="{Binding $parent[Window].UpdatePresentation}"
                 PlacementTarget="{Binding #updateEntryButton}"
                 Placement="BottomEdgeAlignedRight"
                 IsLightDismissEnabled="False"
                 VerticalOffset="-2">
            <Border Padding="16,8,16,24" Background="Transparent"
                    PointerEntered="UpdateReleasePreview_OnPointerEntered"
                    PointerExited="UpdateReleasePreview_OnPointerExited">
              <Border Width="380" MaxHeight="420"
                      Padding="16,14"
                      Background="{DynamicResource PopupBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderStrongBrush}"
                      BorderThickness="1"
                      CornerRadius="12"
                      BoxShadow="0 8 24 0 #40000000">
                <Grid RowDefinitions="Auto,1,*">
                  <StackPanel Spacing="3" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding Update.LatestVersion}" FontSize="12" />
                      <TextBlock Text="{l:Locale update.card.release.notes}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{Binding Update.ReleaseNotesContent.PublishedAtText}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <Border Grid.Row="1" Background="{DynamicResource BorderSoftBrush}" />
                  <views:ReleaseNotesView DataContext="{Binding Update.ReleaseNotesContent}"
                                          Grid.Row="2" Margin="0,8,0,0" />
                </Grid>
              </Border>
            </Border>
          </Popup>
          <Button Grid.Column="2" Classes="window-control" Click="MinimizeButton_OnClick" ToolTip.Tip="{l:Locale window.minimize}" AutomationProperties.Name="{l:Locale window.minimize}">
            <Border Width="12" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
          </Button>
          <Button Grid.Column="3" Classes="window-control" Click="MaximizeButton_OnClick" ToolTip.Tip="{l:Locale window.maximize}" AutomationProperties.Name="{l:Locale window.maximize}">
            <Path Data="M 5,5 L 19,5 L 19,19 L 5,19 Z" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="0.8" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="4" Classes="window-control window-close" Click="CloseButton_OnClick" ToolTip.Tip="{l:Locale window.close}" AutomationProperties.Name="{l:Locale window.close}">
            <Path Data="M 5,5 L 19,19 M 19,5 L 5,19" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="0.8" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="toastBorder" Classes="toast-layer" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,24" Background="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11" MaxWidth="196">
      <TextBlock x:Name="toastText" Foreground="White" TextWrapping="Wrap" />
    </Border>
    <controls:AppModalHost x:Name="appModalHost" ZIndex="300" />
  </Grid>
</Window>
