<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:LoomX.Localization" x:Class="LoomX.MainWindow" Width="1180" Height="760" MinWidth="920" MinHeight="600" Title="Loom-X" Icon="/Assets/app.ico" Background="Transparent" TransparencyLevelHint="AcrylicBlur,Transparent" TransparencyBackgroundFallback="{DynamicResource WindowBackgroundBrush}" SystemDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="0">
  <Window.Styles>
    <Style Selector="Button.nav-button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.nav-button.active">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav-button.active:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav-button.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.navigation-selection-indicator">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.navigation-selection-outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Panel.ZIndex" Value="1" />
    </Style>
    <Style Selector="Path.nav-icon">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Border.glass-sidebar">
      <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.topbar">
      <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.window-chrome">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.window-control /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.window-close:pointerover">
      <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.window-close:pressed">
      <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.window-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>
  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid ColumnDefinitions="228,*">
      <Border Grid.Column="0" Classes="glass-sidebar" Padding="16,24">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="8,0,8,28" PointerPressed="WindowChrome_OnPointerPressed">
            <Image Source="/Assets/icon-transparent.png" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="Loom-X" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
              <Border x:Name="navigationSelectionIndicator" Classes="navigation-selection-indicator" IsVisible="{Binding HasActiveNavigationItem}" Margin="0,2,0,0">
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
              <ItemsControl ItemsSource="{Binding NavigationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding NavigateCommand}" Classes="nav-button" Classes.active="{Binding IsActive}">
                      <StackPanel Orientation="Horizontal" Spacing="11">
                        <Path Classes="nav-icon" Data="{Binding IconData}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border x:Name="navigationSelectionOutline" Classes="navigation-selection-outline" IsVisible="{Binding HasActiveNavigationItem}" Margin="0,2,0,0">
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
            </Grid>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,16,8,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{l:Locale sidebar.service}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock Text="{l:Locale sidebar.version}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Locale sidebar.service}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="104,*">
        <Border Grid.Row="0" Classes="topbar">
          <StackPanel Margin="32,40,32,0" VerticalAlignment="Center" Spacing="5">
            <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Padding="32,20" Background="Transparent">
          <ContentControl Content="{Binding CurrentView}" />
        </Border>
      </Grid>
      <!-- 标题栏覆盖两列，品牌区与内容区都可拖动；按钮位于同一层避免命中区被遮挡。 -->
      <Border Grid.ColumnSpan="2" Classes="window-chrome" Height="32" VerticalAlignment="Top" PointerPressed="WindowChrome_OnPointerPressed">
        <Grid ColumnDefinitions="*,42,42,42" ColumnSpacing="0" Margin="0">
          <Button Grid.Column="1" Classes="window-control" Click="MinimizeButton_OnClick" ToolTip.Tip="{l:Locale window.minimize}" AutomationProperties.Name="{l:Locale window.minimize}">
            <Border Width="12" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
          </Button>
          <Button Grid.Column="2" Classes="window-control" Click="MaximizeButton_OnClick" ToolTip.Tip="{l:Locale window.maximize}" AutomationProperties.Name="{l:Locale window.maximize}">
            <Path Data="M 5,5 L 19,5 L 19,19 L 5,19 Z" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="0.8" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="3" Classes="window-control window-close" Click="CloseButton_OnClick" ToolTip.Tip="{l:Locale window.close}" AutomationProperties.Name="{l:Locale window.close}">
            <Path Data="M 5,5 L 19,19 M 19,5 L 5,19" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="0.8" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </Grid>
    <Border IsVisible="{Binding Update.CardVisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Width="330" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="16" BoxShadow="0 8 24 #40000000">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <PathIcon Data="M 12,2 L 12,14 M 7,9 L 12,14 L 17,9 M 4,16 L 20,16 L 20,20 L 4,20 Z" Foreground="{DynamicResource AccentBrush}" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{l:Locale update.card.title}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="×" Command="{Binding Update.LaterCommand}" Padding="5,0" MinHeight="26" Background="Transparent" BorderBrush="Transparent" ToolTip.Tip="{l:Locale update.card.later.tip}" />
        </Grid>
        <TextBlock Text="{Binding Update.VersionComparison}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Button Content="{l:Locale update.card.release.notes}" Command="{Binding Update.OpenReleaseNotesCommand}" HorizontalAlignment="Left" Padding="0" MinHeight="26" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource AccentBrush}" />
        <ProgressBar IsVisible="{Binding Update.IsBusy}" Value="{Binding Update.DownloadPercent}" Minimum="0" Maximum="100" Height="6" />
        <Grid IsVisible="{Binding Update.IsBusy}" ColumnDefinitions="*,*" ColumnSpacing="8">
          <TextBlock Text="{Binding Update.ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="{Binding Update.SpeedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock IsVisible="{Binding Update.CanRetry}" Text="{Binding Update.ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" FontSize="11" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Button Content="{l:Locale update.card.later}" Command="{Binding Update.LaterCommand}" />
          <Button Grid.Column="1" Content="{l:Locale update.card.download}" Command="{Binding Update.DownloadCommand}" IsEnabled="{Binding Update.CanDownload}" Classes="primary" />
        </Grid>
      </StackPanel>
    </Border>
    <Border IsVisible="{Binding Update.ReleaseNotesVisible}" Background="#99000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="40">
      <Border Width="650" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid RowDefinitions="Auto,*" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:Locale update.card.release.notes}" FontSize="18" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="×" Command="{Binding Update.CloseReleaseNotesCommand}" Padding="6,0" MinHeight="28" Background="Transparent" BorderBrush="Transparent" ToolTip.Tip="{l:Locale update.card.close}" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding Update.ReleaseNotes}" TextWrapping="Wrap" LineHeight="22" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>
    <Border x:Name="toastBorder" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Background="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11" MaxWidth="420">
      <TextBlock x:Name="toastText" Foreground="White" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
