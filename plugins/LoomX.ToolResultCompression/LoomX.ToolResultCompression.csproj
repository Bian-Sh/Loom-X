<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Description>LoomX 第一方 Tool Result Compression 插件：在请求正文发出前压缩历史工具调用结果。</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Import Project="..\..\FirstPartySourcePayload.targets" />
  <ItemGroup>
    <ProjectReference Include="..\..\LoomX.Plugin.Abstractions\LoomX.Plugin.Abstractions.csproj" />
    <!-- 负载使用共享显式清单，只由本目标拷贝；不声明 Content，避免引用方根目录平铺。 -->
    <PluginPayload Include="@(_CompressionPluginPayload)" />
    <!-- 默认文化额外嵌入程序集作为兜底：只拷了一个 DLL 也不会显示原始键名。
         查找与回落规则见 PluginTextCatalog。 -->
    <EmbeddedResource Include="i18n\en-US.json" LogicalName="LoomX.ToolResultCompression.i18n.en-US.json" />
  </ItemGroup>
  <Target Name="CopyPluginPayloadToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(PluginPayload)"
          DestinationFiles="@(PluginPayload->'$(OutputPath)%(PackageRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>