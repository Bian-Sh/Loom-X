{
  "id": "loomx.tool-result-compression",
  "version": "0.2.0",
  "runtime": {
    "kind": "csharp-source",
    "entry_type": "LoomX.ToolResultCompression.ToolResultCompressionPlugin",
    "sources": [
      "CompressionSettingsCommands.cs",
      "CompressionSettingsText.cs",
      "CompressionSettingsUi.cs",
      "CompressionStatsStore.cs",
      "CompressionTokenEstimator.cs",
      "GlobalUsings.cs",
      "ToolResultCompressionObservability.cs",
      "ToolResultCompressionOptions.cs",
      "ToolResultCompressionOptionsStore.cs",
      "ToolResultCompressionPlugin.Commands.cs",
      "ToolResultCompressionPlugin.cs",
      "ToolResultCompressionPlugin.DisplayInfo.cs",
      "ToolResultCompressionPlugin.Ui.cs",
      "ToolResultCompressionRequestExtension.cs",
      "ToolResultCompressionUiText.cs",
      "ToolResultCompressor.cs",
      "ToolResultCompressor.Git.cs",
      "ToolResultCompressor.Json.cs",
      "ToolResultCompressor.Noise.cs",
      "ToolResultCompressor.Output.cs",
      "ToolResultRequestRewriter.cs",
      "ToolResultRequestRewriter.Slots.cs"
    ]
  },
  "capabilities": ["toolresult.compress", "toolresult.dedupe", "toolresult.truncate", "toolresult.summarize"],
  "ui": {
    "contributions": [
      { "id": "observability", "slot": "card-body" },
      { "id": "settings", "slot": "detail-body", "interactive": true }
    ]
  },
  "extensions": [
    {
      "id": "toolresult.request",
      "kind": "request",
      "pipeline": "request",
      "failure_policy": "continue-on-error",
      "capabilities": ["toolresult.compress", "toolresult.dedupe", "toolresult.truncate", "toolresult.summarize"]
    }
  ]
}
