{
  "id": "loomx.tool-result-compression",
  "version": "0.2.0",
  "assembly": "LoomX.ToolResultCompression.dll",
  "plugin_type": "LoomX.ToolResultCompression.ToolResultCompressionPlugin",
  "capabilities": ["toolresult.compress", "toolresult.dedupe", "toolresult.truncate", "toolresult.summarize"],
  "ui": {
    "contributions": [
      { "id": "observability", "slot": "card-body" },
      { "id": "settings", "slot": "detail-body", "interactive": true }
    ]
  },
  "extensions": [
    {
      "id": "toolresult.request",
      "kind": "request",
      "pipeline": "request",
      "failure_policy": "continue-on-error",
      "capabilities": ["toolresult.compress", "toolresult.dedupe", "toolresult.truncate", "toolresult.summarize"]
    }
  ]
}
