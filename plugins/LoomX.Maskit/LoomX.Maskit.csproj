<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>LoomX maskit 脱敏插件：本地敏感规则脱敏与还原，设置页以声明式 UI 动态贡献。</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LoomX.Plugin.Abstractions\LoomX.Plugin.Abstractions.csproj" />
    <Content Include="plugin.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
