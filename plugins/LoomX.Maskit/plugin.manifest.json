{
  "id": "loomx.maskit",
  "version": "0.1.0",
  "assembly": "LoomX.Maskit.dll",
  "plugin_type": "LoomX.Maskit.MaskitPlugin",
  "capabilities": ["maskit.detect", "maskit.mask", "maskit.restore", "maskit.rules"],
  "ui": {
    "contributions": [
      { "id": "overview", "slot": "card-body" },
      { "id": "settings", "slot": "detail-body", "interactive": true }
    ]
  },
  "extensions": [
    {
      "id": "maskit.request",
      "kind": "request",
      "pipeline": "request",
      "failure_policy": "fail-closed",
      "capabilities": ["maskit.detect", "maskit.mask"]
    },
    {
      "id": "maskit.response",
      "kind": "response",
      "pipeline": "response",
      "failure_policy": "fail-closed",
      "capabilities": ["maskit.restore"]
    }
  ]
}
