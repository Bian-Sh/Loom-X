{
  "id": "loomx.credential-protection",
  "version": "0.4.0",
  "assembly": "LoomX.CredentialProtection.dll",
  "plugin_type": "LoomX.CredentialProtection.CredentialProtectionPlugin",
  "capabilities": ["credential.detect", "credential.mask", "credential.restore", "credential.persist"],
  "extensions": [
    {
      "id": "credential.request",
      "kind": "request",
      "pipeline": "request",
      "failure_policy": "fail-closed",
      "capabilities": ["credential.detect", "credential.mask"]
    },
    {
      "id": "credential.response",
      "kind": "response",
      "pipeline": "response",
      "failure_policy": "fail-closed",
      "capabilities": ["credential.restore"]
    },
    {
      "id": "credential.tool-result",
      "kind": "tool-result",
      "pipeline": "tool-result",
      "failure_policy": "fail-closed",
      "capabilities": ["credential.detect", "credential.mask"]
    },
    {
      "id": "credential.persistence",
      "kind": "persistence",
      "pipeline": "persistence",
      "failure_policy": "fail-closed",
      "capabilities": ["credential.detect", "credential.mask", "credential.persist"]
    }
  ]
}
