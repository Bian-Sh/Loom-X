{
  "id": "loomx.credential-protection",
  "version": "0.7.0",
  "runtime": {
    "kind": "csharp-source",
    "entry_type": "LoomX.CredentialProtection.CredentialProtectionPlugin",
    "sources": [
      "CredentialBuiltinGroups.cs",
      "CredentialEngine.cs",
      "CredentialProtectionObservability.cs",
      "CredentialProtectionPlugin.cs",
      "CredentialProtectionPlugin.DisplayInfo.cs",
      "CredentialSettingsCommands.cs",
      "CredentialSettingsText.cs",
      "CredentialSettingsUi.cs",
      "CredentialSynchronous.cs",
      "CredentialTokenStore.cs",
      "GlobalUsings.cs",
      "SensitiveRuleStore.cs"
    ]
  },
  "capabilities": ["credential.detect", "credential.mask", "credential.integrity-instruction", "credential.restore"],
  "ui": {
    "contributions": [
      { "id": "observability", "slot": "card-body" },
      { "id": "settings", "slot": "detail-body", "interactive": true }
    ]
  },
  "host_capabilities": ["storage.sqlite/v1", "protection/v1"],
  "extensions": [
    {
      "id": "credential.request",
      "kind": "request",
      "pipeline": "request",
      "failure_policy": "fail-closed",
      "capabilities": ["credential.detect", "credential.mask", "credential.integrity-instruction"]
    },
    {
      "id": "credential.response",
      "kind": "response",
      "pipeline": "response",
      "failure_policy": "fail-closed",
      "capabilities": ["credential.restore"]
    }
  ]
}
