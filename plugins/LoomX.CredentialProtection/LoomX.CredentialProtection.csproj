<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>LoomX 第一方 Credential Protection 插件：凭据检测、持久化 token 与恢复。</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LoomX.Plugin.Abstractions\LoomX.Plugin.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <Content Include="plugin.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
