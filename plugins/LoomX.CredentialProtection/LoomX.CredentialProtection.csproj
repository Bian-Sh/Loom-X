<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>LoomX 第一方 Credential Protection 插件：凭据检测、持久化 token 与恢复。</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- 文案层是 internal：测试需要逐字段验证四语言文案迁移没有丢内容。 -->
    <InternalsVisibleTo Include="LoomX.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LoomX.Plugin.Abstractions\LoomX.Plugin.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- 插件负载：plugin.manifest.json 与 i18n/<culture>.json。
         只由下面的自定义目标拷进本插件自己的输出目录，宿主与测试工程再把整个目录拷进 plugins/<id>/。
         刻意不使用 Content + CopyToOutputDirectory：MSBuild 会把 Content 传给所有引用方，
         多个插件的同名负载平铺到同一个输出根目录后只剩最后一份，且那份内容是错的
         （ProjectReference 上的 ExcludeAssets="content" 拦不住这条路径）。
         文件名与相对路径因此在所有工程里都固定为 plugins/<id>/ 下的同名同位置。 -->
    <PluginPayload Include="plugin.manifest.json" />
    <PluginPayload Include="i18n\**\*.json" />
    <!-- 默认文化额外嵌入程序集作为兜底：只拷了一个 DLL 也不会显示原始键名。
         查找与回落规则见 PluginTextCatalog。 -->
    <EmbeddedResource Include="i18n\en-US.json" LogicalName="LoomX.CredentialProtection.i18n.en-US.json" />
  </ItemGroup>
  <Target Name="CopyPluginPayloadToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(PluginPayload)"
          DestinationFiles="@(PluginPayload->'$(OutputPath)%(RelativeDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>